{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Newsletter subscribers'|trans }}{% endblock %}
{% block body_testid %}newsletter-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.tools.index') }}">{{ 'Tools'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Newsletter'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="newsletter-page">
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Newsletter subscribers'|trans } %}
            {% block actions %}
                <a href="{{ export_url }}" class="btn btn-outline-primary btn-sm" data-testid="newsletter-export-button">
                    <i class="bi bi-download" aria-hidden="true"></i> {{ 'Export CSV'|trans }}
                </a>
            {% endblock %}
        {% endembed %}

        {{ component('BoDataTable', {
            id: 'newsletter',
            columns: [
                column('id', 'ID'|trans, 'start', 'id', hideBelow: 'md'),
                column('email', 'Email'|trans, 'start', 'email'),
                column('firstname', 'First name'|trans, 'start', 'firstname', hideBelow: 'xl'),
                column('lastname', 'Last name'|trans, 'start', 'lastname', hideBelow: 'lg'),
                column_html('locale', 'Locale'|trans, 'center', hideBelow: 'lg'),
                column('created_at', 'Subscribed on'|trans, 'start', 'created_at', hideBelow: 'lg'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No newsletter subscribers.'|trans,
            sortField: sort_field,
            sortDirection: sort_direction,
        }) }}
    </div>
{% endblock %}
