{% component 'BoCreateDialog' with {
    id: 'customer-create-modal',
    title: 'Create a new customer',
    form: create_form,
    formAction: path('admin.customer.create'),
    submitLabel: 'Create this customer',
    testid: 'customer-create',
    hook: 'customer.create-form',
} %}
    {% block fields %}
        <p class="text-muted small">{{ 'A random password will be generated and sent to the customer.'|trans }}</p>
        {% include '@BackOfficeDefaultTwig/customer/_customer_form_fields.html.twig' with { form: create_form } only %}
    {% endblock %}
{% endcomponent %}
