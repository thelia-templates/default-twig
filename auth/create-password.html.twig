{% extends '@BackOfficeDefaultTwig/auth-layout.html.twig' %}

{% block title %}{{ 'Create password'|trans }}{% endblock %}
{% block auth_title %}{{ 'Create password'|trans }}{% endblock %}
{% block auth_subtitle %}{{ 'Set a new password for your back-office account'|trans }}{% endblock %}

{% block auth_content %}
    {{ form_start(form, { attr: { 'data-testid': 'create-password-form', novalidate: 'novalidate' } }) }}
        {% if form.vars.errors|length > 0 %}
            <div class="alert alert-danger" role="alert" data-testid="create-password-error">
                {{ form_errors(form) }}
            </div>
        {% endif %}

        <div class="mb-3">
            {{ form_label(form.password, 'New password'|trans, { label_attr: { class: 'form-label' } }) }}
            {{ form_widget(form.password, {
                attr: {
                    class: 'form-control form-control-lg',
                    autofocus: 'autofocus',
                    'data-testid': 'create-password-password',
                },
            }) }}
            {{ form_errors(form.password) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.password_confirm, 'Confirm new password'|trans, { label_attr: { class: 'form-label' } }) }}
            {{ form_widget(form.password_confirm, {
                attr: {
                    class: 'form-control form-control-lg',
                    'data-testid': 'create-password-confirm',
                },
            }) }}
            {{ form_errors(form.password_confirm) }}
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100" data-testid="create-password-submit">
            <i class="bi bi-check-lg me-2"></i>{{ 'Save new password'|trans }}
        </button>
    {{ form_end(form) }}

    <div class="text-center mt-3">
        <a class="text-decoration-none small" href="{{ path('admin.login') }}">
            <i class="bi bi-arrow-left me-1"></i>{{ 'Back to login'|trans }}
        </a>
    </div>
{% endblock %}
