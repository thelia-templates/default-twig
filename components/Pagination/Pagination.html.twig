{#
    BoPagination - windowed pagination with previous/next, ellipses and first/last shortcuts.

    Replaces the {% for n in 1..pages %} flat lists that overflow on large datasets.

    Props:
        route        route name used to build each page link (required)
        currentPage  current page, 1-based (required)
        lastPage     total number of pages (required)
        routeParams  extra params merged into every link; empty values are dropped (default: {})
        pageParam    query/route parameter carrying the page number (default: page)
        window       pages shown on each side of the current one (default: 2)
        align        start | center | end (default: center)
        spacing      spacing classes keeping the nav off the table above (default: mt-4;
                     pass '' when the caller already spaces it, e.g. inside a card-footer)
        ariaLabel    nav aria-label, |trans (default: Pagination)
        testid       data-testid on the nav (default: none)
#}
{% if lastPage > 1 %}
    {%- set justify = align == 'center' ? ' justify-content-center' : (align == 'end' ? ' justify-content-end' : '') -%}
    <nav class="{{ spacing ?? 'mt-4' }}" aria-label="{{ (ariaLabel ?? 'Pagination')|trans }}"{% if testid %} data-testid="{{ testid }}"{% endif %}>
        <ul class="pagination{{ justify }} mb-0">
            <li class="page-item{% if currentPage <= 1 %} disabled{% endif %}">
                {% if currentPage <= 1 %}
                    <span class="page-link" aria-hidden="true">&lsaquo;</span>
                {% else %}
                    <a class="page-link" href="{{ path(route, this.linkParams(currentPage - 1)) }}" aria-label="{{ 'Previous'|trans }}">&lsaquo;</a>
                {% endif %}
            </li>
            {% for n in this.pages %}
                {#- Entries two pages away from the current one only exist because of the
                    default window of 2; below md they collapse to a window of 1 by hiding
                    them in CSS rather than duplicating the bar or changing the window. The
                    first/last page shortcuts getPages() always keeps must never be hidden by
                    this rule, even when they happen to land exactly two pages from the current
                    one (e.g. currentPage=1, lastPage=3). -#}
                {% set isEdge = n == 1 or n == lastPage %}
                {% set farFromCurrent = n is not null and not isEdge and (n - currentPage)|abs == 2 %}
                {% if loop.last and this.hasCollapsedTrailingGap %}
                    {#- Symmetric trailing case: the page right before the last one collapses
                        away below md without a native ellipsis to signal it - inserted right
                        before that last page so it lands where the gap actually is. -#}
                    <li class="page-item disabled d-md-none"><span class="page-link">&hellip;</span></li>
                {% endif %}
                {% if n is null %}
                    <li class="page-item disabled{% if farFromCurrent %} d-none d-md-inline-block{% endif %}"><span class="page-link">&hellip;</span></li>
                {% else %}
                    <li class="page-item{% if n == currentPage %} active{% endif %}{% if farFromCurrent %} d-none d-md-inline-block{% endif %}"{% if n == currentPage %} aria-current="page"{% endif %}>
                        <a class="page-link" href="{{ path(route, this.linkParams(n)) }}">{{ n }}</a>
                    </li>
                {% endif %}
                {% if loop.first and this.hasCollapsedLeadingGap %}
                    {#- getPages() has no null between the first page and the next one, but
                        collapsing to a window of 1 below md hides that next page anyway:
                        without this, "1" and "3" would sit next to each other with nothing
                        marking the skipped page. Shown only below md, where the gap exists. -#}
                    <li class="page-item disabled d-md-none"><span class="page-link">&hellip;</span></li>
                {% endif %}
            {% endfor %}
            <li class="page-item{% if currentPage >= lastPage %} disabled{% endif %}">
                {% if currentPage >= lastPage %}
                    <span class="page-link" aria-hidden="true">&rsaquo;</span>
                {% else %}
                    <a class="page-link" href="{{ path(route, this.linkParams(currentPage + 1)) }}" aria-label="{{ 'Next'|trans }}">&rsaquo;</a>
                {% endif %}
            </li>
        </ul>
    </nav>
{% endif %}
