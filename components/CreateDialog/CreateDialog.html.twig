{#
    BoCreateDialog - modal wrapping a Symfony form (create/edit).

    Replaces the repeated _create_modal/_edit_modal pattern (form_start + included fields + safe_hook).

    Props:
        id              the modal id (required)
        title           header title, |trans (required)
        form            the Symfony FormView (required)
        formAction      form action URL (required)
        method          form method (default: post)
        fieldsTemplate  template included in the body with { form } to render the fields (default: none)
        submitLabel     submit button label, |trans (default: Save)
        submitIcon      submit button icon class (default: bi-check2)
        submitVariant   submit button colour (default: primary)
        cancelLabel     cancel button label, |trans (default: Cancel)
        size            modal-dialog size class (default: modal-lg)
        testid          base data-testid: appends -form / -submit (default: none)
        hook            a hook name rendered through safe_hook in the body (default: none)
        hookContext     arguments passed to safe_hook (e.g. { administrator_id: id }) (default: [])

    Extra body content can be added through the fields block:
        {% component 'BoCreateDialog' with { ... } %}{% block fields %}…{% endblock %}{% endcomponent %}
#}
<div class="modal fade" id="{{ id }}" tabindex="-1" aria-labelledby="{{ id }}-title" aria-hidden="true">
    <div class="modal-dialog{% if size %} {{ size }}{% endif %} modal-dialog-scrollable">
        <div class="modal-content">
            {% form_theme form with bo_form_themes only %}
            {{ form_start(form, { action: formAction, method: method, attr: testid ? { 'data-testid': testid ~ '-form' } : {} }) }}
                <div class="modal-header">
                    <h2 class="modal-title h5" id="{{ id }}-title">{{ title|trans }}</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                <div class="modal-body">
                    {% if fieldsTemplate %}{% include fieldsTemplate with { form: form } only %}{% endif %}
                    {% block fields %}{% endblock %}
                    {%- set effective_hook = hook ?? ((testid and testid ends with '-create') ? testid|slice(0, -7) ~ '.create-form' : null) -%}
                    {% if effective_hook %}{{ safe_hook(effective_hook, hookContext) }}{% endif %}
                    {% if form._token is defined %}{{ form_widget(form._token) }}{% endif %}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ cancelLabel|trans }}</button>
                    <button type="submit" class="btn btn-{{ submitVariant }}"{% if testid %} data-testid="{{ testid }}-submit"{% endif %}>
                        <i class="bi {{ submitIcon }}" aria-hidden="true"></i> {{ submitLabel|trans }}
                    </button>
                </div>
            {# render_rest would append the fields no template rendered *after* the footer,
               outside the scrollable body: a module extending the form renders its own field
               through the dialog hook instead (see the back-office form bridge). #}
            {{ form_end(form, { render_rest: false }) }}
        </div>
    </div>
</div>
