{# @var id string #}
{# @var columns list<\BackOfficeDefaultTwigBundle\UiComponents\DataTable\Column> #}
{# @var rows list<array<string, mixed>> #}
{% set sort_base_url = sortBaseUrl ?? app.request.pathInfo %}
<div class="card" data-testid="datatable-{{ id }}">
    {% if caption %}
        <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">{{ caption }}</h2>
            <div class="datatable-toolbar">
                {% block toolbar %}{% endblock %}
            </div>
        </div>
    {% endif %}

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0" data-testid="datatable-{{ id }}-table">
            <thead class="table-light">
                <tr>
                    {% for column in columns %}
                        <th scope="col" class="text-{{ column.cellAlign }}">
                            {%- if column.sortKey -%}
                                {%- set isActive = sortField == column.sortKey -%}
                                {%- set nextDirection = isActive and sortDirection == 'asc' ? 'desc' : 'asc' -%}
                                {%- set sortParams = sortKeepParams|merge({ (sortParam): column.sortKey, (sortDirectionParam): nextDirection }) -%}
                                <a class="text-decoration-none text-reset d-inline-flex align-items-center gap-1"
                                   href="{{ sort_base_url }}?{{ sortParams|url_encode }}"
                                   data-testid="datatable-{{ id }}-sort-{{ column.sortKey }}">
                                    {{ column.label }}
                                    <i class="bi {{ isActive ? (sortDirection == 'asc' ? 'bi-sort-up' : 'bi-sort-down') : 'bi-arrow-down-up text-muted' }}" aria-hidden="true"></i>
                                </a>
                            {%- else -%}
                                {{ column.label }}
                            {%- endif -%}
                        </th>
                    {% endfor %}
                    {{ safe_hook(extraColumnsHeaderHook ?? ((hook ?: id) ~ '.table-header'), { table_id: id }) }}
                </tr>
            </thead>
            <tbody{% for attr, value in tbodyAttributes %} {{ attr }}="{{ value }}"{% endfor %}>
                {% for row in rows %}
                    <tr data-testid="datatable-{{ id }}-row" data-row-id="{{ row.id|default('') }}"{% if row._row_class is defined and row._row_class %} class="{{ row._row_class }}"{% endif %}>
                        {% for column in columns %}
                            <td class="text-{{ column.cellAlign }}" data-testid="datatable-{{ id }}-cell-{{ column.key }}">
                                {% include '@BackOfficeDefaultTwig/components/DataTable/cells/' ~ column.kind.value ~ '.html.twig' with {
                                    column: column,
                                    row: row,
                                    value: row[column.key]|default(null),
                                } only %}
                            </td>
                        {% endfor %}
                        {{ safe_hook(extraColumnsHook ?? ((hook ?: id) ~ '.table-row'), { table_id: id, row: row, row_id: row.id|default(null) }) }}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ columns|length }}" class="text-center text-muted py-4" data-testid="datatable-{{ id }}-empty">
                            {{ emptyMessage|default('No data'|trans) }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
