{%- set variants = column.options.variants|default({}) -%}
{%- set variant = variants[value]|default(null) -%}
{%- set labelKey = column.options.label_key|default(null) -%}
{%- set label = labelKey ? row[labelKey] : value -%}
{%- set colorKey = column.options.color_key|default(null) -%}
{%- set color = colorKey ? row[colorKey]|default(null) : null -%}
{%- if color -%}
    <span class="badge" style="background-color: {{ color }}; color: #fff;">{{ label }}</span>
{%- else -%}
    <span class="badge text-bg-{{ variant|default('secondary') }}">{{ label }}</span>
{%- endif -%}
