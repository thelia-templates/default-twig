<div class="modal fade"
     id="{{ id }}"
     tabindex="-1"
     aria-labelledby="{{ id }}-title"
     aria-hidden="true"
     data-controller="bo-modal-fetch"
     data-bo-modal-fetch-trigger-attribute-value="{{ triggerAttribute }}"
     {% if testid %}data-testid="{{ testid }}"{% endif %}>
    <div class="modal-dialog{% if size %} modal-{{ size }}{% endif %} modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="{{ id }}-title">{{ title }}</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
            </div>
            <div class="modal-body" data-bo-modal-fetch-target="body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
            </div>
        </div>
    </div>
</div>
