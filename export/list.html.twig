{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Export'|trans }}{% endblock %}
{% block body_testid %}export-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.tools.index') }}">{{ 'Tools'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Export'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="export-page">
        <h1 class="h3 mb-3">{{ 'Available exports'|trans }}</h1>

        {% if categories is empty %}
            <p class="text-muted">{{ 'No export defined.'|trans }}</p>
        {% else %}
            <div class="row g-4">
                {% for category in categories %}
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">{{ category.title }}</div>
                            <table class="table table-hover align-middle mb-0">
                                <tbody data-controller="bo-sortable"
                                       data-bo-sortable-url-value="{{ position_url }}"
                                       data-bo-sortable-token-value="{{ position_token }}"
                                       data-bo-sortable-param-name-value="export_id">
                                    {% for export in category.exports %}
                                        <tr data-row-id="{{ export.id }}">
                                            <td class="text-muted" style="width: 1%"><i class="bi bi-grip-vertical" aria-hidden="true"></i></td>
                                            <td>
                                                <strong>{{ export.title }}</strong>
                                                {% if export.description %}<div class="text-muted small">{{ export.description }}</div>{% endif %}
                                            </td>
                                            <td class="text-end">
                                                <a href="{{ path('export.view', { id: export.id }) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-download" aria-hidden="true"></i> {{ 'Export'|trans }}</a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr><td class="text-muted small">{{ 'No export in this category.'|trans }}</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('exports.js', { location: 'exports-js' }) }}
{% endblock %}
