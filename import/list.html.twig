{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Import'|trans }}{% endblock %}
{% block body_testid %}import-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.tools.index') }}">{{ 'Tools'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Import'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="import-page">
        <h1 class="h3 mb-3">{{ 'Available imports'|trans }}</h1>

        {{ safe_hook('imports.top', { location: 'imports-top' }) }}

        {% if categories is empty %}
            <p class="text-muted">{{ 'No import defined.'|trans }}</p>
        {% else %}
            <div class="row g-4">
                {% for category in categories %}
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">{{ category.title }}</div>
                            {{ safe_hook('imports.row', { category: category.id|default(null) }) }}
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>{{ safe_hook('import.table-header') }}</tr>
                                </thead>
                                <tbody data-controller="bo-sortable"
                                       data-bo-sortable-url-value="{{ position_url }}"
                                       data-bo-sortable-token-value="{{ position_token }}"
                                       data-bo-sortable-param-name-value="import_id">
                                    {% for import in category.imports %}
                                        <tr data-row-id="{{ import.id }}">
                                            <td class="text-muted" style="width: 1%"><i class="bi bi-grip-vertical" aria-hidden="true"></i></td>
                                            <td>
                                                <strong>{{ import.title }}</strong>
                                                {% if import.description %}<div class="text-muted small">{{ import.description }}</div>{% endif %}
                                            </td>
                                            <td class="text-end">
                                                <a href="{{ path('import.view', { id: import.id }) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-upload" aria-hidden="true"></i> {{ 'Import'|trans }}</a>
                                            </td>
                                            {{ safe_hook('import.table-row', { import_id: import.id }) }}
                                        </tr>
                                    {% else %}
                                        <tr><td class="text-muted small">{{ 'No import in this category.'|trans }}</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {{ safe_hook('imports.bottom', { location: 'imports-bottom' }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('imports.js', { location: 'imports-js' }) }}
{% endblock %}
