{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Order'|trans }} #{{ order.ref }}{% endblock %}
{% block body_testid %}order-detail{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.order.list') }}">{{ 'Orders'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">#{{ order.ref }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('order-edit.top', { order: order.id }) }}

    {% set extra_tabs = hook_block('order.tab', { order: order.id, id: order.id }) %}

    <div class="container-fluid" data-testid="order-detail-page">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h1 class="h3 mb-1">{{ 'Order'|trans }} <small class="text-muted">#{{ order.ref }}</small></h1>
                <div class="d-flex gap-2 align-items-center small text-muted">
                    {% if current_status %}
                        <span class="badge" style="background-color: {{ current_status.color }}; color: #fff;" data-testid="order-status-badge">{{ current_status.title }}</span>
                    {% endif %}
                    {% if order.createdAt %}
                        <span data-testid="order-created-at"><i class="bi bi-calendar3"></i> {{ order.createdAt|date('d/m/Y H:i') }}</span>
                    {% endif %}
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ invoice_url }}" target="_blank" class="btn btn-outline-secondary" data-testid="order-invoice-link">
                    <i class="bi bi-file-pdf" aria-hidden="true"></i> {{ 'Invoice'|trans }}
                </a>
                <a href="{{ delivery_url }}" target="_blank" class="btn btn-outline-secondary" data-testid="order-delivery-link">
                    <i class="bi bi-file-pdf" aria-hidden="true"></i> {{ 'Delivery slip'|trans }}
                </a>
                {% if cancel_status_id > 0 and not is_canceled %}
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#order-cancel-modal" data-testid="order-cancel-btn">
                        <i class="bi bi-x-circle" aria-hidden="true"></i> {{ 'Cancel order'|trans }}
                    </button>
                {% endif %}
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Order items'|trans }}</span>
                        <small class="text-muted">{{ 'Prices in %currency'|trans({'%currency': currency.symbol}) }}</small>
                    </div>
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle" data-testid="order-items-table">
                            <thead>
                                <tr>
                                    <th>{{ 'Product'|trans }}</th>
                                    <th class="text-end">{{ 'Unit price (excl. tax)'|trans }}</th>
                                    <th class="text-end">{{ 'Tax'|trans }}</th>
                                    <th class="text-end">{{ 'Unit price (incl. tax)'|trans }}</th>
                                    <th class="text-end">{{ 'Quantity'|trans }}</th>
                                    <th class="text-end">{{ 'Line total (excl. tax)'|trans }}</th>
                                    <th class="text-end">{{ 'Line tax'|trans }}</th>
                                    <th class="text-end">{{ 'Line total (incl. tax)'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in order_items %}
                                    <tr data-testid="order-item-row" data-order-product-id="{{ item.id }}">
                                        <td>
                                            <div><code>{{ item.ref }}</code> &mdash; <strong>{{ item.title }}</strong>
                                                {% if item.virtual %}
                                                    <i class="bi bi-download text-muted" title="{{ 'Virtual product'|trans }}" aria-hidden="true"></i>
                                                {% endif %}
                                            </div>
                                            {% if item.pse_ref and item.pse_ref != item.ref %}
                                                <small class="text-muted d-block">{{ 'Combination reference'|trans }}: <code>{{ item.pse_ref }}</code></small>
                                            {% endif %}
                                            {% if item.combinations|length > 0 %}
                                                <dl class="row mb-0 mt-1 small">
                                                    {% for combination in item.combinations %}
                                                        <dt class="col-sm-4 fw-normal text-muted">{{ combination.attribute_title }}</dt>
                                                        <dd class="col-sm-8 mb-0">{{ combination.attribute_av_title }}</dd>
                                                    {% endfor %}
                                                </dl>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">{{ item.price|number_format(2, '.', ' ') }} {{ currency.symbol }}</td>
                                        <td class="text-end">{{ item.tax|number_format(2, '.', ' ') }} {{ currency.symbol }}</td>
                                        <td class="text-end">{{ item.unit_taxed_price|number_format(2, '.', ' ') }} {{ currency.symbol }}</td>
                                        <td class="text-end">{{ item.quantity }}</td>
                                        <td class="text-end">{{ item.line_ht|number_format(2, '.', ' ') }} {{ currency.symbol }}</td>
                                        <td class="text-end">{{ item.line_tax|number_format(2, '.', ' ') }} {{ currency.symbol }}</td>
                                        <td class="text-end fw-semibold">{{ item.line_ttc|number_format(2, '.', ' ') }} {{ currency.symbol }}</td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="8" class="text-muted text-center">{{ 'No item.'|trans }}</td></tr>
                                {% endfor %}
                            </tbody>
                            {% if order_items|length > 0 %}
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="7" class="text-end fw-bold">{{ 'Items subtotal (incl. tax)'|trans }}</td>
                                        <td class="text-end fw-bold" data-testid="order-items-subtotal">{{ totals.subtotal_ttc|number_format(2, '.', ' ') }} {{ currency.symbol }}</td>
                                    </tr>
                                </tfoot>
                            {% endif %}
                        </table>
                    </div>
                </div>

                <div class="card mb-3" data-testid="order-taxes-breakdown">
                    <div class="card-header">{{ 'Taxes detail'|trans }}</div>
                    <div class="card-body py-2">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <h6 class="text-muted text-uppercase small mb-2">{{ 'Items taxes'|trans }}</h6>
                                <ul class="list-group list-group-flush small" data-testid="order-taxes-items">
                                    {% for label, amount in totals.items_taxes %}
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span>{{ label }}</span>
                                            <strong>{{ amount|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                                        </li>
                                    {% else %}
                                        <li class="list-group-item px-0 text-muted">{{ 'None'|trans }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted text-uppercase small mb-2">{{ 'Shipping taxes'|trans }}</h6>
                                <ul class="list-group list-group-flush small" data-testid="order-taxes-shipping">
                                    {% if totals.postage_tax > 0 %}
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span>{{ totals.postage_tax_rule_title|default('-') }}</span>
                                            <strong>{{ totals.postage_tax|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                                        </li>
                                    {% else %}
                                        <li class="list-group-item px-0 text-muted">{{ 'None'|trans }}</li>
                                    {% endif %}
                                </ul>
                                {% if totals.discount_tax > 0 %}
                                    <h6 class="text-muted text-uppercase small mt-3 mb-2">{{ 'Discount tax'|trans }}</h6>
                                    <ul class="list-group list-group-flush small" data-testid="order-taxes-discount">
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span>{{ 'Average rate'|trans }}</span>
                                            <strong>- {{ totals.discount_tax|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                                        </li>
                                    </ul>
                                {% endif %}
                            </div>
                        </div>
                        <hr class="my-3">
                        <div class="d-flex justify-content-between">
                            <strong>{{ 'Taxes total'|trans }}</strong>
                            <strong data-testid="order-taxes-total">{{ totals.total_tax|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">{{ 'Order management'|trans }}</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="order-status-select">{{ 'Order status'|trans }}</label>
                                <form action="{{ path('admin.order.update.status', { order_id: order.id }) }}?_token={{ token }}" method="post" class="d-flex gap-2" data-testid="order-status-form">
                                    <select id="order-status-select" name="status_id" class="form-select" data-testid="order-status-select">
                                        {% for s in available_statuses %}
                                            {% if s.id > 0 %}
                                                <option value="{{ s.id }}" {% if s.id == order.statusId %}selected{% endif %}>{{ s.title }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="btn btn-primary flex-shrink-0" data-testid="order-status-submit">{{ 'Update'|trans }}</button>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="order-delivery-ref-input">{{ 'Tracking reference'|trans }}</label>
                                <form action="{{ path('admin.order.update.deliveryRef', { order_id: order.id }) }}?_token={{ token }}" method="post" class="d-flex gap-2" data-testid="order-delivery-ref-form">
                                    <input type="text" id="order-delivery-ref-input" name="delivery_ref" value="{{ order.deliveryRef }}" class="form-control" placeholder="{{ 'Tracking number'|trans }}" data-testid="order-delivery-ref-input">
                                    <button type="submit" class="btn btn-primary flex-shrink-0" data-testid="order-delivery-ref-submit">{{ 'Update'|trans }}</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        {% include '@BackOfficeDefaultTwig/order/_address_card.html.twig' with {
                            kind: 'invoice',
                            title: 'Invoice address'|trans,
                            address: order_addresses.invoice,
                            customer_email: customer ? customer.email : null,
                            hook: null,
                        } only %}
                    </div>
                    <div class="col-md-6">
                        {% include '@BackOfficeDefaultTwig/order/_address_card.html.twig' with {
                            kind: 'delivery',
                            title: 'Delivery address'|trans,
                            address: order_addresses.delivery,
                            customer_email: null,
                            hook: safe_hook('order-edit.bill-delivery-address', { order_id: order.id, module_id: delivery.module_id }),
                        } only %}
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card mb-3" data-testid="order-totals">
                    <div class="card-header">{{ 'Totals'|trans }}</div>
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Total without tax'|trans }}</span>
                            <strong data-testid="order-totals-subtotal-ht">{{ totals.subtotal_ht|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Total with taxes before discount'|trans }}</span>
                            <strong>{{ (totals.subtotal_ttc + totals.discount)|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        {% if totals.discount > 0 %}
                            <li class="list-group-item d-flex justify-content-between text-danger">
                                <span>{{ 'Discount with taxes'|trans }}</span>
                                <strong data-testid="order-totals-discount">- {{ totals.discount|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                            </li>
                        {% endif %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Total with taxes after discount'|trans }}</span>
                            <strong data-testid="order-totals-subtotal-ttc">{{ totals.subtotal_ttc|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Shipping with taxes'|trans }}</span>
                            <strong data-testid="order-totals-postage">{{ totals.postage_ttc|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between bg-light">
                            <span class="fw-bold">{{ 'Order total with taxes'|trans }}</span>
                            <strong data-testid="order-totals-grand">{{ totals.grand_total|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between text-muted">
                            <span>{{ 'Total weight'|trans }}</span>
                            <span data-testid="order-totals-weight">{{ weight|number_format(2, '.', ' ') }} {{ 'kg'|trans }}</span>
                        </li>
                    </ul>
                </div>

                {% if coupons|length > 0 %}
                    <div class="card mb-3" data-testid="order-coupons">
                        <div class="card-header">{{ 'Coupons'|trans }}</div>
                        <ul class="list-group list-group-flush small">
                            {% for coupon in coupons %}
                                <li class="list-group-item d-flex justify-content-between">
                                    <span><code>{{ coupon.code }}</code>{% if coupon.title %} <span class="text-muted">- {{ coupon.title }}</span>{% endif %}</span>
                                    <strong class="text-danger">- {{ coupon.amount|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {% if customer %}
                    <div class="card mb-3" data-testid="order-customer">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span>{{ 'Customer'|trans }}</span>
                            <a href="{{ customer.edit_url }}" class="btn btn-sm btn-outline-secondary" data-testid="order-customer-edit">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i> {{ 'Open'|trans }}
                            </a>
                        </div>
                        <div class="card-body small">
                            <p class="mb-1"><strong>{{ customer.firstname }} {{ customer.lastname }}</strong>{% if customer.ref %} <span class="text-muted">({{ customer.ref }})</span>{% endif %}</p>
                            {% if customer.email %}
                                <p class="mb-0"><a href="mailto:{{ customer.email }}" data-testid="order-customer-email">{{ customer.email }}</a></p>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                <div class="card mb-3" data-testid="order-payment">
                    <div class="card-header">{{ 'Payment'|trans }}</div>
                    <div class="card-body small">
                        <p class="mb-1"><strong>{{ payment.module_title|default('-') }}</strong></p>
                        {% if payment.transaction_ref %}
                            <p class="mb-1 text-muted">{{ 'Transaction ref'|trans }}: <code>{{ payment.transaction_ref }}</code></p>
                        {% endif %}
                        {% if payment.invoice_ref %}
                            <p class="mb-1 text-muted">{{ 'Invoice ref'|trans }}: <code>{{ payment.invoice_ref }}</code></p>
                        {% endif %}
                        {{ safe_hook('order-edit.payment-module-bottom', { order_id: order.id, module_id: payment.module_id }) }}
                    </div>
                </div>

                <div class="card mb-3" data-testid="order-delivery">
                    <div class="card-header">{{ 'Delivery'|trans }}</div>
                    <div class="card-body small">
                        <p class="mb-1"><strong>{{ delivery.module_title|default('-') }}</strong></p>
                        {% if delivery.delivery_ref %}
                            <p class="mb-1 text-muted">{{ 'Tracking ref'|trans }}: <code>{{ delivery.delivery_ref }}</code></p>
                        {% endif %}
                        {{ safe_hook('order-edit.delivery-module-bottom', { order_id: order.id, module_id: delivery.module_id }) }}
                    </div>
                </div>

            </div>
        </div>
    </div>

    {% if extra_tabs|length > 0 or has_hook('order.tab-content') %}
        <div class="container-fluid mt-4" data-testid="order-detail-modules">
            <ul class="nav nav-tabs mb-3" role="tablist">
                {% for block in extra_tabs %}
                    <li class="nav-item" role="presentation">
                        <button class="nav-link {% if loop.first %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#{{ block.id }}"
                                {% if block.href is defined and block.href %}data-href="{{ block.href }}"{% endif %}
                                type="button" data-testid="order-tab-{{ block.id }}">{{ block.title }}</button>
                    </li>
                {% endfor %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link {% if extra_tabs|length == 0 %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-modules" type="button" data-testid="order-tab-modules">
                        {{ 'Modules'|trans }}
                    </button>
                </li>
            </ul>
            <div class="tab-content">
                {% for block in extra_tabs %}
                    <div class="tab-pane fade {% if loop.first %}show active{% endif %}" id="{{ block.id }}" role="tabpanel">
                        {% if block.href is defined and block.href %}
                            <div class="text-center"><span class="loading">{{ 'Please wait, loading'|trans }}</span></div>
                        {% else %}
                            {{ block.content|raw }}
                        {% endif %}
                    </div>
                {% endfor %}
                <div class="tab-pane fade {% if extra_tabs|length == 0 %}show active{% endif %}" id="tab-modules" role="tabpanel">
                    {{ safe_hook('order.tab-content', { order: order.id, order_id: order.id, location: 'order-edit', view: 'order' }) }}
                </div>
            </div>
        </div>
    {% endif %}

    {% if order_addresses.invoice or order_addresses.delivery %}
        {% include '@BackOfficeDefaultTwig/order/_address_modal.html.twig' with {
            order: order,
            customer_titles: customer_titles,
            countries: countries,
            states: states,
            token: token,
        } only %}
    {% endif %}

    {% if cancel_status_id > 0 and not is_canceled %}
        <div class="modal fade" id="order-cancel-modal" tabindex="-1" aria-hidden="true" data-testid="order-cancel-modal">
            <div class="modal-dialog">
                <form method="post" action="{{ path('admin.order.update.status', { order_id: order.id }) }}?_token={{ token }}" data-testid="order-cancel-form">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Cancel order'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="status_id" value="{{ cancel_status_id }}">
                            <p>{{ 'Do you really want to cancel this order?'|trans }} <strong>#{{ order.ref }}</strong></p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
                            <button type="submit" class="btn btn-danger" data-testid="order-cancel-submit">
                                <i class="bi bi-x-circle" aria-hidden="true"></i> {{ 'Cancel this order'|trans }}
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}

    {{ safe_hook('order-edit.bottom', { order: order.id }) }}
{% endblock %}
