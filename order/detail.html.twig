{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Order'|trans }} #{{ order.ref }}{% endblock %}
{% block body_testid %}order-detail{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.order.list') }}">{{ 'Orders'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">#{{ order.ref }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('order-edit.top', { order: order.id }) }}

    {% set extra_tabs = hook_block('order.tab', { order: order.id, id: order.id }) %}

    <div class="container-fluid" data-testid="order-detail-page">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Order'|trans }} <small class="text-muted">#{{ order.ref }}</small></h1>
            <div class="d-flex gap-2">
                <a href="{{ invoice_url }}" target="_blank" class="btn btn-outline-secondary" data-testid="order-invoice-link">
                    <i class="bi bi-file-pdf" aria-hidden="true"></i> {{ 'Invoice'|trans }}
                </a>
                <a href="{{ delivery_url }}" target="_blank" class="btn btn-outline-secondary" data-testid="order-delivery-link">
                    <i class="bi bi-file-pdf" aria-hidden="true"></i> {{ 'Delivery slip'|trans }}
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card mb-3">
                    <div class="card-header">{{ 'Order items'|trans }}</div>
                    <table class="table mb-0" data-testid="order-items-table">
                        <thead>
                            <tr>
                                <th>{{ 'Reference'|trans }}</th>
                                <th>{{ 'Title'|trans }}</th>
                                <th class="text-end">{{ 'Quantity'|trans }}</th>
                                <th class="text-end">{{ 'Unit price'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in order_items %}
                                <tr>
                                    <td>{{ item.ref }}</td>
                                    <td>{{ item.title }}</td>
                                    <td class="text-end">{{ item.quantity }}</td>
                                    <td class="text-end">{{ item.price|number_format(2) }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="4" class="text-muted text-center">{{ 'No item.'|trans }}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="card mb-3">
                    <div class="card-header">{{ 'Update status'|trans }}</div>
                    <div class="card-body">
                        <form action="{{ path('admin.order.update.status', { order_id: order.id }) }}?_token={{ token }}" method="post" data-testid="order-status-form">
                            <div class="row g-2">
                                <div class="col-md-9">
                                    <select name="status_id" class="form-select" data-testid="order-status-select">
                                        {% for s in available_statuses %}
                                            {% if s.id > 0 %}
                                                <option value="{{ s.id }}" {% if s.id == order.statusId %}selected{% endif %}>{{ s.title }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-primary w-100" data-testid="order-status-submit">{{ 'Update'|trans }}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">{{ 'Delivery reference'|trans }}</div>
                    <div class="card-body">
                        <form action="{{ path('admin.order.update.deliveryRef', { order_id: order.id }) }}?_token={{ token }}" method="post" class="d-flex gap-2" data-testid="order-delivery-ref-form">
                            <input type="text" name="delivery_ref" value="{{ order.deliveryRef }}" class="form-control" data-testid="order-delivery-ref-input">
                            <button type="submit" class="btn btn-primary" data-testid="order-delivery-ref-submit">{{ 'Update'|trans }}</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card mb-3" data-testid="order-totals">
                    <div class="card-header">{{ 'Totals'|trans }}</div>
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Subtotal (excl. tax)'|trans }}</span>
                            <strong data-testid="order-totals-subtotal-ht">{{ totals.subtotal_ht|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Taxes'|trans }}</span>
                            <strong data-testid="order-totals-taxes">{{ totals.subtotal_taxes|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Subtotal (incl. tax)'|trans }}</span>
                            <strong data-testid="order-totals-subtotal-ttc">{{ totals.subtotal_ttc|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ 'Shipping'|trans }}</span>
                            <strong data-testid="order-totals-postage">{{ totals.postage_ttc|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        {% if totals.discount > 0 %}
                            <li class="list-group-item d-flex justify-content-between text-danger">
                                <span>{{ 'Discount'|trans }}</span>
                                <strong data-testid="order-totals-discount">- {{ totals.discount|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                            </li>
                        {% endif %}
                        <li class="list-group-item d-flex justify-content-between bg-light">
                            <span class="fw-bold">{{ 'Grand total'|trans }}</span>
                            <strong data-testid="order-totals-grand">{{ totals.grand_total|number_format(2, '.', ' ') }} {{ currency.symbol }}</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between text-muted">
                            <span>{{ 'Total weight'|trans }}</span>
                            <span data-testid="order-totals-weight">{{ weight|number_format(2, '.', ' ') }} {{ 'kg'|trans }}</span>
                        </li>
                    </ul>
                </div>

                {% if customer %}
                    <div class="card mb-3" data-testid="order-customer">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span>{{ 'Customer'|trans }}</span>
                            <a href="{{ customer.edit_url }}" class="btn btn-sm btn-outline-secondary" data-testid="order-customer-edit">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i> {{ 'Open'|trans }}
                            </a>
                        </div>
                        <div class="card-body small">
                            <p class="mb-1"><strong>{{ customer.firstname }} {{ customer.lastname }}</strong>{% if customer.ref %} <span class="text-muted">({{ customer.ref }})</span>{% endif %}</p>
                            {% if customer.email %}
                                <p class="mb-0"><a href="mailto:{{ customer.email }}" data-testid="order-customer-email">{{ customer.email }}</a></p>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                <div class="card mb-3" data-testid="order-payment">
                    <div class="card-header">{{ 'Payment'|trans }}</div>
                    <div class="card-body small">
                        <p class="mb-1"><strong>{{ payment.module_title|default('—') }}</strong></p>
                        {% if payment.transaction_ref %}
                            <p class="mb-1 text-muted">{{ 'Transaction ref'|trans }}: <code>{{ payment.transaction_ref }}</code></p>
                        {% endif %}
                        {% if payment.invoice_ref %}
                            <p class="mb-0 text-muted">{{ 'Invoice ref'|trans }}: <code>{{ payment.invoice_ref }}</code></p>
                        {% endif %}
                    </div>
                </div>

                <div class="card mb-3" data-testid="order-delivery">
                    <div class="card-header">{{ 'Delivery'|trans }}</div>
                    <div class="card-body small">
                        <p class="mb-1"><strong>{{ delivery.module_title|default('—') }}</strong></p>
                        {% if delivery.delivery_ref %}
                            <p class="mb-0 text-muted">{{ 'Tracking ref'|trans }}: <code>{{ delivery.delivery_ref }}</code></p>
                        {% endif %}
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Invoice address'|trans }}</span>
                        {% if order_addresses.invoice %}
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal" data-bs-target="#order-address-modal"
                                    data-address-payload="{{ order_addresses.invoice|json_encode|e('html_attr') }}"
                                    data-address-kind="invoice"
                                    data-testid="order-invoice-address-edit">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i> {{ 'Edit'|trans }}
                            </button>
                        {% endif %}
                    </div>
                    <div class="card-body" data-testid="order-invoice-address">
                        {% if order_addresses.invoice %}
                            <p>{{ order_addresses.invoice.firstname }} {{ order_addresses.invoice.lastname }}</p>
                            {% if order_addresses.invoice.company %}<p>{{ order_addresses.invoice.company }}</p>{% endif %}
                            <p>{{ order_addresses.invoice.address1 }}<br>{{ order_addresses.invoice.zipcode }} {{ order_addresses.invoice.city }}</p>
                            <p>{{ order_addresses.invoice.phone }}</p>
                        {% else %}
                            <p class="text-muted">{{ 'No invoice address.'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Delivery address'|trans }}</span>
                        {% if order_addresses.delivery %}
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal" data-bs-target="#order-address-modal"
                                    data-address-payload="{{ order_addresses.delivery|json_encode|e('html_attr') }}"
                                    data-address-kind="delivery"
                                    data-testid="order-delivery-address-edit">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i> {{ 'Edit'|trans }}
                            </button>
                        {% endif %}
                    </div>
                    <div class="card-body" data-testid="order-delivery-address">
                        {% if order_addresses.delivery %}
                            <p>{{ order_addresses.delivery.firstname }} {{ order_addresses.delivery.lastname }}</p>
                            {% if order_addresses.delivery.company %}<p>{{ order_addresses.delivery.company }}</p>{% endif %}
                            <p>{{ order_addresses.delivery.address1 }}<br>{{ order_addresses.delivery.zipcode }} {{ order_addresses.delivery.city }}</p>
                            <p>{{ order_addresses.delivery.phone }}</p>
                        {% else %}
                            <p class="text-muted">{{ 'No delivery address.'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if extra_tabs|length > 0 or has_hook('order.tab-content') %}
        <div class="container-fluid mt-4" data-testid="order-detail-modules">
            <ul class="nav nav-tabs mb-3" role="tablist">
                {% for block in extra_tabs %}
                    <li class="nav-item" role="presentation">
                        <button class="nav-link {% if loop.first %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#{{ block.id }}"
                                {% if block.href is defined and block.href %}data-href="{{ block.href }}"{% endif %}
                                type="button" data-testid="order-tab-{{ block.id }}">{{ block.title }}</button>
                    </li>
                {% endfor %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link {% if extra_tabs|length == 0 %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-modules" type="button" data-testid="order-tab-modules">
                        {{ 'Modules'|trans }}
                    </button>
                </li>
            </ul>
            <div class="tab-content">
                {% for block in extra_tabs %}
                    <div class="tab-pane fade {% if loop.first %}show active{% endif %}" id="{{ block.id }}" role="tabpanel">
                        {% if block.href is defined and block.href %}
                            <div class="text-center"><span class="loading">{{ 'Please wait, loading'|trans }}</span></div>
                        {% else %}
                            {{ block.content|raw }}
                        {% endif %}
                    </div>
                {% endfor %}
                <div class="tab-pane fade {% if extra_tabs|length == 0 %}show active{% endif %}" id="tab-modules" role="tabpanel">
                    {{ safe_hook('order.tab-content', { order: order.id, order_id: order.id, location: 'order-edit', view: 'order' }) }}
                </div>
            </div>
        </div>
    {% endif %}

    {% if order_addresses.invoice or order_addresses.delivery %}
        {% include '@BackOfficeDefaultTwig/order/_address_modal.html.twig' with {
            order: order,
            customer_titles: customer_titles,
            countries: countries,
            states: states,
            token: token,
        } only %}
    {% endif %}

    {{ safe_hook('order-edit.bottom', { order: order.id }) }}
{% endblock %}
