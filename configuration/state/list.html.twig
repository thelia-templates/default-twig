{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'States'|trans }}{% endblock %}
{% block body_testid %}states-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="/admin/configuration">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'States'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('states.top') }}

    <div class="container-fluid" data-testid="states-page">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'States'|trans }}</h1>
            {% if is_granted('CREATE', 'admin.configuration.state') %}
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#state-create-modal" data-testid="state-create-button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a new state'|trans }}
                </button>
            {% endif %}
        </div>

        <form method="get" action="{{ path('admin.configuration.states.default') }}" class="row g-2 mb-3">
            <div class="col-md-6">
                <label class="form-label" for="state-country-filter">{{ 'Filter by country'|trans }}</label>
                <select name="country_id" id="state-country-filter" class="form-select">
                    <option value="0">{{ 'All countries'|trans }}</option>
                    {% for country in countries %}
                        <option value="{{ country.id }}" {% if country.id == current_country %}selected{% endif %}>{{ country.title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-secondary" type="submit">{{ 'Filter'|trans }}</button>
            </div>
        </form>

        {{ component('BoDataTable', {
            id: 'states',
            columns: [
                column('id', 'ID'|trans, 'start', 'id'),
                column('title', 'State'|trans, 'start', 'title'),
                column('isocode', 'ISO'|trans, 'center', 'iso_code'),
                column('country', 'Country'|trans),
                column_toggle('visible', 'Online'|trans, 'toggle_visible_url'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No state defined.'|trans,
            sortField: sort_field,
            sortDirection: sort_direction,
            sortKeepParams: { country_id: current_country ?: null },
        }) }}
    </div>

    {{ safe_hook('states.bottom') }}

    {% include '@BackOfficeDefaultTwig/configuration/state/_create_modal.html.twig' %}
    {% include '@BackOfficeDefaultTwig/configuration/state/_delete_modal.html.twig' %}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('states.js', { location: 'states-js' }) }}
{% endblock %}
