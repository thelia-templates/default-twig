{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Countries'|trans }}{% endblock %}
{% block body_testid %}countries-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="/admin/configuration">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Countries'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('countries.top') }}

    <div class="container-fluid" data-testid="countries-page">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Countries'|trans }}</h1>
            {% if is_granted('CREATE', 'admin.configuration.country') %}
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#country-create-modal" data-testid="country-create-button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a new country'|trans }}
                </button>
            {% endif %}
        </div>

        {{ component('BoDataTable', {
            id: 'countries',
            columns: [
                column('id', 'ID'|trans),
                column('title', 'Country'|trans),
                column('isoalpha2', 'ISO-2'|trans, 'center'),
                column('isoalpha3', 'ISO-3'|trans, 'center'),
                column('isocode', 'Numeric'|trans, 'center'),
                column_toggle('visible', 'Online'|trans, 'toggle_visible_url'),
                column_radio('default', 'Default'|trans, 'country_default', 'id', 'default', null, 'toggle_default_url'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No country defined.'|trans,
        }) }}
    </div>

    {{ safe_hook('countries.bottom') }}

    {% include '@BackOfficeDefaultTwig/configuration/country/_create_modal.html.twig' %}
    {% include '@BackOfficeDefaultTwig/configuration/country/_delete_modal.html.twig' %}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('countries.js', { location: 'countries-js' }) }}
{% endblock %}
