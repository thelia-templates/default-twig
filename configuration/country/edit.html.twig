{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit country'|trans }} - {{ country.title }}{% endblock %}
{% block body_testid %}country-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="/admin/configuration">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.countries.default') }}">{{ 'Countries'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ country.title }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="country-edit-page">
        {{ safe_hook('country-edit.top', { country_id: country.id }) }}
        <h1 class="h3 mb-2">{{ 'Country'|trans }} <small class="text-muted">{{ country.isoalpha2 }} - #{{ country.id }}</small></h1>

        <div class="mb-3">
            {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
        </div>

        <div class="card">
            <div class="card-body">
                {{ form_start(form, { action: path('admin.configuration.countries.save'), method: 'post' }) }}
                    <input type="hidden" name="country_id" value="{{ country.id }}">
                    <div class="row g-3">
                        <div class="col-lg-6">{{ form_row(form.title) }}</div>
                        <div class="col-md-4 col-lg-2">{{ form_row(form.isocode) }}</div>
                        <div class="col-md-4 col-lg-2">{{ form_row(form.isoalpha2) }}</div>
                        <div class="col-md-4 col-lg-2">{{ form_row(form.isoalpha3) }}</div>
                    </div>

                    <hr class="my-4">

                    <div class="row g-3">
                        <div class="col-md-5">{{ form_row(form.area) }}</div>
                        <div class="col-md-7">
                            <span class="form-label d-block">{{ 'Options'|trans }}</span>
                            <div class="d-flex flex-wrap gap-4">
                                <div class="form-check form-switch">
                                    {{ form_widget(form.visible, { attr: { class: 'form-check-input' } }) }}
                                    {{ form_label(form.visible, null, { label_attr: { class: 'form-check-label' } }) }}
                                </div>
                                <div class="form-check form-switch">
                                    {{ form_widget(form.has_states, { attr: { class: 'form-check-input' } }) }}
                                    {{ form_label(form.has_states, null, { label_attr: { class: 'form-check-label' } }) }}
                                </div>
                                <div class="form-check form-switch">
                                    {{ form_widget(form.need_zip_code, { attr: { class: 'form-check-input' } }) }}
                                    {{ form_label(form.need_zip_code, null, { label_attr: { class: 'form-check-label' } }) }}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">{{ form_row(form.zip_code_format) }}</div>
                    </div>

                    <hr class="my-4">

                    <div class="row g-3">
                        <div class="col-12">{{ form_row(form.chapo) }}</div>
                        <div class="col-12">{{ form_row(form.description) }}</div>
                        <div class="col-12">{{ form_row(form.postscriptum) }}</div>
                    </div>
                    {{ form_widget(form.id) }}
                    {{ form_widget(form.locale) }}
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a href="{{ path('admin.configuration.countries.default') }}" class="btn btn-outline-secondary">{{ 'Cancel'|trans }}</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> {{ 'Save'|trans }}</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
        {{ safe_hook('country-edit.bottom', { country_id: country.id }) }}
    </div>
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('country.edit-js', { country_id: country.id, location: 'country-edit-js' }) }}
{% endblock %}
