{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Attributes'|trans }}{% endblock %}
{% block body_testid %}configuration-attributes{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Attributes'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('attributes.top') }}

    <div class="container-fluid" data-testid="attributes-page">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Attributes management'|trans }}</h1>
            {% if is_granted('CREATE', 'admin.configuration.attribute') %}
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#attribute-create-modal" data-testid="attribute-create-button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    {{ 'Add a new attribute'|trans }}
                </button>
            {% endif %}
        </div>

        {{ component('BoDataTable', {
            id: 'attributes',
            columns: [
                column('id', 'ID'|trans),
                column('title', 'Title'|trans),
                column('position', 'Position'|trans, 'center'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No attribute defined yet.'|trans,
            tbodyAttributes: {
                'data-controller': 'bo-sortable',
                'data-bo-sortable-url-value': update_position_url,
                'data-bo-sortable-token-value': update_position_token,
                'data-bo-sortable-param-name-value': 'attribute_id',
            },
        }) }}
    </div>

    {{ safe_hook('attributes.bottom') }}

    {% component 'BoCreateDialog' with {
        id: 'attribute-create-modal',
        title: 'Create a new attribute',
        form: create_form,
        formAction: path('admin.configuration.attributes.create'),
        submitLabel: 'Create',
        testid: 'attribute-create',
        hook: 'attribute.create-form',
        size: '',
    } %}
        {% block fields %}
            <div class="mb-3">
                {{ form_label(create_form.title) }}
                {{ form_widget(create_form.title, { attr: { class: 'form-control' } }) }}
                {{ form_errors(create_form.title) }}
            </div>
            <div class="form-check mb-3">
                {{ form_widget(create_form.add_to_all, { attr: { class: 'form-check-input' } }) }}
                {{ form_label(create_form.add_to_all, null, { label_attr: { class: 'form-check-label' } }) }}
            </div>
            {{ form_widget(create_form.locale) }}
        {% endblock %}
    {% endcomponent %}

    {{ component('BoConfirmDialog', {
        id: 'attribute-delete-modal',
        title: 'Delete attribute',
        formAction: path('admin.configuration.attributes.delete'),
        message: 'Do you really want to delete this attribute?',
        testid: 'attribute-delete',
        prefillTrigger: 'data-attribute-id',
        prefillInput: 'attribute_id',
    }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('attributes.js', { location: 'attributes-js' }) }}
{% endblock %}
