{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Thelia Shipping zones'|trans }}{% endblock %}
{% block body_testid %}shipping-zones-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="/admin/configuration">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Shipping configuration'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('shipping-zones.top', { location: 'shipping_zones_top' }) }}

    <div class="container-fluid" data-testid="shipping-zones-page">
        <h1 class="h3 mb-3">{{ 'Shipping configuration'|trans }}</h1>

        {% if unattached_areas|length > 0 %}
            <div class="alert alert-warning" role="alert">
                <strong>{{ 'Warning'|trans }}</strong>, {{ 'some of your shipping zones are not attached to any delivery module:'|trans }}
                {% for area in unattached_areas %}
                    <a href="{{ path('admin.configuration.shipping-configuration.update.view', { area_id: area.id }) }}">{{ area.name }}</a>{% if not loop.last %}, {% else %}.{% endif %}
                {% endfor %}
            </div>
        {% endif %}

        {% set table_rows = [] %}
        {% for row in rows %}
            {% set zones_html = '' %}
            {% if row.zones is empty %}
                {% set zones_html = '<span class="text-muted fst-italic">' ~ 'There are no shipping zones attached to this module.'|trans|e ~ '</span>' %}
            {% else %}
                {% for zone in row.zones %}
                    {% set zone_url = path('admin.configuration.shipping-configuration.update.view', { area_id: zone.id }) %}
                    {% set zones_html = zones_html ~ '<a href="' ~ zone_url|e ~ '" title="' ~ zone.countries|e ~ '">' ~ zone.name|e ~ '</a>' %}
                    {% if not loop.last %}{% set zones_html = zones_html ~ ', ' %}{% endif %}
                {% endfor %}
            {% endif %}
            {% set table_rows = table_rows|merge([{
                'id': row.id,
                'module': row.code ~ ' - ' ~ row.title,
                'zones_html': zones_html,
                '_actions': [ row_action('edit', 'Edit'|trans, row.edit_url, null, 'UPDATE', 'admin.configuration.shipping-zone') ],
            }]) %}
        {% endfor %}

        {{ component('BoDataTable', {
            id: 'shipping-zones',
            columns: [
                column('module', 'Delivery module'|trans),
                column_html('zones_html', 'Shipping zones for this module'|trans),
                column_actions(),
            ],
            rows: table_rows,
            emptyMessage: 'No shipping zone defined yet. Click the + button to create one.'|trans,
        }) }}
    </div>

    {{ safe_hook('shipping-zones.bottom', { location: 'shipping_zones_bottom' }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('shipping-zones.js', { location: 'shipping-zones-js' }) }}
{% endblock %}
