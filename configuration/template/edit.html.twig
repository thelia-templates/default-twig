{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit template'|trans }} - {{ template.name }}{% endblock %}
{% block body_testid %}configuration-template-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.templates.default') }}">{{ 'Templates'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ template.name }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('template-edit.top', { template_id: template.id }) }}

    <div class="container-fluid" data-testid="template-edit-page">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Template'|trans }} <small class="text-muted">#{{ template.id }}</small></h1>
            <a href="{{ path('admin.configuration.templates.default') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to list'|trans }}
            </a>
        </div>

        <div class="d-flex justify-content-end mb-3">
            {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
        </div>

        <div class="row">
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header">{{ 'General'|trans }}</div>
                    <div class="card-body">
                        {{ form_start(form, { action: path('admin.configuration.templates.save', { template_id: template.id }), method: 'post', attr: { 'data-testid': 'template-edit-form' } }) }}
                            <input type="hidden" name="template_id" value="{{ template.id }}">
                            <div class="mb-3">
                                {{ form_label(form.name) }}
                                {{ form_widget(form.name, { attr: { class: 'form-control' } }) }}
                                {{ form_errors(form.name) }}
                            </div>
                            {{ form_widget(form.id) }}
                            {{ form_widget(form.locale) }}
                            {{ component('BoSaveModeToolbar', {
                                closeUrl: path('admin.configuration.templates.default'),
                                wrapperClass: '',
                                testid: 'template-edit',
                            }) }}
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Features'|trans }}</span>
                        {% if available_features|length > 0 %}
                            <form action="{{ path('admin.configuration.templates.features.add') }}?_token={{ assignToken() }}" method="post" class="d-flex gap-2" data-testid="template-add-feature-form">
                                <input type="hidden" name="template_id" value="{{ template.id }}">
                                <select name="feature_id" class="form-select form-select-sm" data-testid="template-add-feature-select">
                                    {% for feature in available_features %}
                                        <option value="{{ feature.id }}">{{ feature.title }}</option>
                                    {% endfor %}
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary" data-testid="template-add-feature-submit">{{ 'Add'|trans }}</button>
                            </form>
                        {% endif %}
                    </div>
                    {% include '@BackOfficeDefaultTwig/configuration/template/_features_table.html.twig' %}
                </div>

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Attributes'|trans }}</span>
                        {% if available_attributes|length > 0 %}
                            <form action="{{ path('admin.configuration.templates.attributes.add') }}?_token={{ assignToken() }}" method="post" class="d-flex gap-2" data-testid="template-add-attribute-form">
                                <input type="hidden" name="template_id" value="{{ template.id }}">
                                <select name="attribute_id" class="form-select form-select-sm" data-testid="template-add-attribute-select">
                                    {% for attribute in available_attributes %}
                                        <option value="{{ attribute.id }}">{{ attribute.title }}</option>
                                    {% endfor %}
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary" data-testid="template-add-attribute-submit">{{ 'Add'|trans }}</button>
                            </form>
                        {% endif %}
                    </div>
                    {% include '@BackOfficeDefaultTwig/configuration/template/_attributes_table.html.twig' %}
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card" data-testid="template-products-using">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Products using this template'|trans }}</span>
                        <span class="badge bg-secondary" data-testid="template-products-using-count">{{ products_using|length }}</span>
                    </div>
                    {% if products_using|length > 0 %}
                        <table class="table table-striped mb-0" data-testid="template-products-using-table">
                            <thead>
                                <tr>
                                    <th>{{ 'ID'|trans }}</th>
                                    <th>{{ 'Reference'|trans }}</th>
                                    <th>{{ 'Title'|trans }}</th>
                                    <th class="text-end">{{ 'Actions'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for product in products_using %}
                                    <tr data-testid="template-products-using-row-{{ product.id }}">
                                        <td>{{ product.id }}</td>
                                        <td>{{ product.ref }}</td>
                                        <td>{{ product.title }}</td>
                                        <td class="text-end">
                                            <a href="{{ product.edit_url }}" class="btn btn-sm btn-outline-secondary" data-testid="template-products-using-edit-{{ product.id }}">
                                                <i class="bi bi-pencil" aria-hidden="true"></i> {{ 'Edit'|trans }}
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <div class="card-body text-muted" data-testid="template-products-using-empty">
                            {{ 'This template is not used by any product.'|trans }}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="col-md-6">
                <div class="card" data-testid="template-categories-defaulting">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Default template for categories'|trans }}</span>
                        <span class="badge bg-secondary" data-testid="template-categories-defaulting-count">{{ categories_defaulting|length }}</span>
                    </div>
                    {% if categories_defaulting|length > 0 %}
                        <table class="table table-striped mb-0" data-testid="template-categories-defaulting-table">
                            <thead>
                                <tr>
                                    <th>{{ 'ID'|trans }}</th>
                                    <th>{{ 'Title'|trans }}</th>
                                    <th class="text-end">{{ 'Actions'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for category in categories_defaulting %}
                                    <tr data-testid="template-categories-defaulting-row-{{ category.id }}">
                                        <td>{{ category.id }}</td>
                                        <td>{{ category.title }}</td>
                                        <td class="text-end">
                                            <a href="{{ category.edit_url }}" class="btn btn-sm btn-outline-secondary" data-testid="template-categories-defaulting-edit-{{ category.id }}">
                                                <i class="bi bi-pencil" aria-hidden="true"></i> {{ 'Edit'|trans }}
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <div class="card-body text-muted" data-testid="template-categories-defaulting-empty">
                            {{ 'No category uses this template as its default.'|trans }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {{ safe_hook('template-edit.bottom', { template_id: template.id }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('wysiwyg.js', { location: 'template-edit-js' }) }}
{% endblock %}
