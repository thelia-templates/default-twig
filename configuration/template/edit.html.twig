{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit template'|trans }} - {{ template.name }}{% endblock %}
{% block body_testid %}configuration-template-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.templates.default') }}">{{ 'Templates'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ template.name }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('template-edit.top', { template_id: template.id }) }}

    <div class="container-fluid" data-testid="template-edit-page">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Template'|trans }} <small class="text-muted">#{{ template.id }}</small></h1>
            <a href="{{ path('admin.configuration.templates.default') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to list'|trans }}
            </a>
        </div>

        <div class="mb-3">
            {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
        </div>

        <div class="row">
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header">{{ 'General'|trans }}</div>
                    <div class="card-body">
                        {% form_theme form with bo_form_themes only %}
                        {{ form_start(form, { action: path('admin.configuration.templates.save', { template_id: template.id }), method: 'post', attr: { 'data-testid': 'template-edit-form' } }) }}
                            <input type="hidden" name="template_id" value="{{ template.id }}">
                            <div class="mb-3">
                                {{ form_label(form.name) }}
                                {{ form_widget(form.name, { attr: { class: 'form-control' } }) }}
                                {{ form_errors(form.name) }}
                            </div>
                            {{ form_widget(form.id) }}
                            {{ form_widget(form.locale) }}
                            {{ component('BoSaveModeToolbar', {
                                closeUrl: path('admin.configuration.templates.default'),
                                wrapperClass: '',
                                testid: 'template-edit',
                            }) }}
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Features'|trans }}</span>
                        {% if available_features|length > 0 %}
                            <form action="{{ path('admin.configuration.templates.features.add') }}?_token={{ assignToken() }}" method="post" data-testid="template-add-feature-form">
                                <input type="hidden" name="template_id" value="{{ template.id }}">
                                <div class="input-group input-group-sm w-auto">
                                    <select name="feature_id" class="form-select" data-testid="template-add-feature-select">
                                        {% for feature in available_features %}
                                            <option value="{{ feature.id }}">{{ feature.title }}</option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="btn btn-primary" data-testid="template-add-feature-submit">{{ 'Add'|trans }}</button>
                                </div>
                            </form>
                        {% endif %}
                    </div>
                    {% include '@BackOfficeDefaultTwig/configuration/template/_features_table.html.twig' %}
                </div>

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Attributes'|trans }}</span>
                        {% if available_attributes|length > 0 %}
                            <form action="{{ path('admin.configuration.templates.attributes.add') }}?_token={{ assignToken() }}" method="post" data-testid="template-add-attribute-form">
                                <input type="hidden" name="template_id" value="{{ template.id }}">
                                <div class="input-group input-group-sm w-auto">
                                    <select name="attribute_id" class="form-select" data-testid="template-add-attribute-select">
                                        {% for attribute in available_attributes %}
                                            <option value="{{ attribute.id }}">{{ attribute.title }}</option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="btn btn-primary" data-testid="template-add-attribute-submit">{{ 'Add'|trans }}</button>
                                </div>
                            </form>
                        {% endif %}
                    </div>
                    {% include '@BackOfficeDefaultTwig/configuration/template/_attributes_table.html.twig' %}
                </div>
            </div>
        </div>

        {% if choice_filter is defined %}
            {% include '@BackOfficeDefaultTwig/catalog/_choice_filter_section.html.twig' with { data: choice_filter, scope_template_id: template.id } only %}
        {% endif %}

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card" data-testid="template-products-using">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Products using this template'|trans }}</span>
                        <span class="badge bg-secondary" data-testid="template-products-using-count">{{ products_using|length }}</span>
                    </div>
                    {% set products_using_rows = [] %}
                    {% for product in products_using %}
                        {% set products_using_rows = products_using_rows|merge([{
                            'id': product.id,
                            'ref': product.ref,
                            'title': product.title,
                            '_actions': [ row_action('edit', 'Edit'|trans, product.edit_url) ],
                        }]) %}
                    {% endfor %}
                    {{ component('BoDataTable', {
                        id: 'products-using',
                        columns: [
                            column('id', 'ID'|trans),
                            column('ref', 'Reference'|trans),
                            column('title', 'Title'|trans),
                            column_actions(),
                        ],
                        rows: products_using_rows,
                        emptyMessage: 'This template is not used by any product.'|trans,
                    }) }}
                </div>
            </div>

            <div class="col-md-6">
                <div class="card" data-testid="template-categories-defaulting">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Default template for categories'|trans }}</span>
                        <span class="badge bg-secondary" data-testid="template-categories-defaulting-count">{{ categories_defaulting|length }}</span>
                    </div>
                    {% set categories_defaulting_rows = [] %}
                    {% for category in categories_defaulting %}
                        {% set categories_defaulting_rows = categories_defaulting_rows|merge([{
                            'id': category.id,
                            'title': category.title,
                            '_actions': [ row_action('edit', 'Edit'|trans, category.edit_url) ],
                        }]) %}
                    {% endfor %}
                    {{ component('BoDataTable', {
                        id: 'categories-defaulting',
                        columns: [
                            column('id', 'ID'|trans),
                            column('title', 'Title'|trans),
                            column_actions(),
                        ],
                        rows: categories_defaulting_rows,
                        emptyMessage: 'No category uses this template as its default.'|trans,
                    }) }}
                </div>
            </div>
        </div>
    </div>

    {{ safe_hook('template-edit.bottom', { template_id: template.id }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('template.edit-js', { location: 'template-edit-js' }) }}
    {{ safe_hook('wysiwyg.js', { location: 'template-edit-js' }) }}
{% endblock %}
