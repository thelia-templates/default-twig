{% set columns = [
    column('title', 'Attribute'|trans),
    column('position', 'Position'|trans, 'center'),
    column_actions(),
] %}

{% set rows = [] %}
{% for attribute in attributes %}
    {% set rows = rows|merge([{
        'id': attribute.id,
        'title': attribute.title,
        'position': attribute.position,
        '_actions': [
            row_action('delete', 'Remove this attribute from the template?'|trans, attribute.delete_url),
        ],
    }]) %}
{% endfor %}

{{ component('BoDataTable', {
    id: 'template-attributes',
    columns: columns,
    rows: rows,
    emptyMessage: 'No attribute attached.'|trans,
    extraColumnsHeaderHook: 'template.attributes-table-header',
    extraColumnsHook: 'template.attributes-table-row',
    headerHookContext: { location: 'template_attributes_table_header' },
    rowHookContext: { location: 'template_attributes_table_row' },
    tbodyAttributes: {
        'data-controller': 'bo-sortable',
        'data-bo-sortable-url-value': attribute_position_url,
        'data-bo-sortable-token-value': position_token,
        'data-bo-sortable-param-name-value': 'attribute_id',
    },
}) }}
