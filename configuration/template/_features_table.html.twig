{% set rows = [] %}
{% for feature in features %}
    {% set rows = rows|merge([{
        'id': feature.id,
        'title': feature.title,
        'position': feature.position,
        '_actions': [ row_action('delete', 'Remove this feature from the template?'|trans, feature.delete_url) ],
    }]) %}
{% endfor %}
{{ component('BoDataTable', {
    id: 'template-features',
    columns: [
        column('title', 'Feature'|trans),
        column('position', 'Position'|trans, 'center'),
        column_actions(),
    ],
    rows: rows,
    emptyMessage: 'No feature attached.'|trans,
    extraColumnsHeaderHook: 'template.features-table-header',
    extraColumnsHook: 'template.features-table-row',
    headerHookContext: { location: 'template_features_table_header' },
    rowHookContext: { location: 'template_features_table_row' },
    tbodyAttributes: {
        'data-controller': 'bo-sortable',
        'data-bo-sortable-url-value': feature_position_url,
        'data-bo-sortable-token-value': position_token,
        'data-bo-sortable-param-name-value': 'feature_id',
        'data-bo-sortable-extra-params-value': '{"template_id": ' ~ template.id ~ '}',
    },
}) }}
