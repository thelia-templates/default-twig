{# Pure HTML fragment: the admin-logs results card.
   Shared by the full page (list.html.twig) and the AJAX logger endpoint, so a
   $.post to admin.configuration.admin-logs.logger keeps receiving a fragment, not a full page. #}
<div class="card" data-testid="admin-logs-results">
    <div class="card-header bg-body-tertiary d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <h2 class="h5 mb-0">{{ 'Log entries'|trans }}</h2>
        <span class="badge bg-secondary" data-testid="admin-logs-count">{{ entries|length }}</span>
    </div>
    {% set columns = [
        column_html('date',     'Date'|trans),
        column('admin',         'Admin'|trans, hideBelow: 'lg'),
        column_html('resource', 'Resource'|trans, hideBelow: 'lg'),
        column('message',       'Message'|trans),
    ] %}
    {% set rows = [] %}
    {% for entry in entries %}
        {% set rows = rows|merge([{
            'id':       loop.index,
            'date':     '<code>' ~ entry.date|e ~ '</code>',
            'admin':    entry.admin,
            'resource': '<code>' ~ entry.resource|e ~ ':' ~ entry.action|e ~ (entry.resource_id ? ':' ~ entry.resource_id|e : '') ~ '</code>',
            'message':  entry.message,
        }]) %}
    {% endfor %}
    {{ component('BoDataTable', {
        id: 'admin-logs-table',
        columns: columns,
        rows: rows,
        emptyMessage: 'No log entries match the current filter.'|trans,
    }) }}
</div>
