{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Taxes rules'|trans }}{% endblock %}
{% block body_testid %}configuration-taxes-rules{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Taxes rules'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('taxes-rules.top') }}

    <div class="container-fluid" data-testid="taxes-rules-page">
        <h1 class="h3 mb-3">{{ 'Taxes rules'|trans }}</h1>

        <div class="alert alert-info">
            <p class="mb-1">{{ 'Taxes define the amount of money added to the product price.'|trans }}</p>
            <p class="mb-0">{{ 'Tax rules are combinations of different taxes, applied per country.'|trans }}</p>
        </div>

        <section class="mb-4" data-testid="taxes-section">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h5 mb-0">{{ 'Taxes'|trans }}</h2>
                {% if is_granted('CREATE', 'admin.configuration.tax') %}
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#tax-create-modal" data-testid="tax-create-button">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        {{ 'Create a new tax'|trans }}
                    </button>
                {% endif %}
            </div>

            {{ component('BoDataTable', {
                id: 'taxes',
                columns: [
                    column('title', 'Name'|trans, 'start', 'title'),
                    column_html('description', 'Description'|trans),
                    column_actions('_actions', 'Actions'|trans),
                ],
                rows: tax_rows,
                emptyMessage: 'No tax defined yet.'|trans,
                sortField: tax_sort_field,
                sortDirection: tax_sort_direction,
                sortParam: 'tax_order',
                sortDirectionParam: 'tax_direction',
                sortKeepParams: { tax_rule_order: tax_rule_sort_field != 'id' ? tax_rule_sort_field : null, tax_rule_direction: tax_rule_sort_direction != 'asc' ? tax_rule_sort_direction : null },
            }) }}
        </section>

        <section class="mb-4" data-testid="tax-rules-section">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h5 mb-0">{{ 'Tax rules'|trans }}</h2>
                {% if is_granted('CREATE', 'admin.configuration.tax') %}
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#tax-rule-create-modal" data-testid="tax-rule-create-button">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        {{ 'Create a new tax rule'|trans }}
                    </button>
                {% endif %}
            </div>

            {{ component('BoDataTable', {
                id: 'tax-rules',
                columns: [
                    column('title', 'Name'|trans, 'start', 'title'),
                    column_html('default_badge', 'Default'|trans, 'start', 'is_default'),
                    column_actions('_actions', 'Actions'|trans),
                ],
                rows: tax_rule_rows|map(row => row|merge({
                    default_badge: row.is_default
                        ? '<span class="badge bg-success">' ~ ('Default'|trans) ~ '</span>'
                        : '',
                })),
                emptyMessage: 'No tax rule defined yet.'|trans,
                sortField: tax_rule_sort_field,
                sortDirection: tax_rule_sort_direction,
                sortParam: 'tax_rule_order',
                sortDirectionParam: 'tax_rule_direction',
                sortKeepParams: { tax_order: tax_sort_field != 'id' ? tax_sort_field : null, tax_direction: tax_sort_direction != 'asc' ? tax_sort_direction : null },
            }) }}
        </section>

        {% if is_granted('UPDATE', 'admin.configuration.tax') %}
            <section data-testid="tax-rule-delivery-section">
                <h2 class="h5 mb-2">{{ 'Tax rule for delivery modules'|trans }}</h2>
                <div class="card mb-3">
                    <div class="card-body">
                        <form method="post" action="{{ path('admin.configuration.taxes-rules.delivery.modules.update') }}?_token={{ assignToken() }}" data-testid="tax-rule-delivery-form">
                            <label for="delivery-module-tax-rule" class="form-label">{{ 'Select a tax rule'|trans }}</label>
                            <div class="input-group">
                                <select id="delivery-module-tax-rule" name="delivery-module-tax-rule" class="form-select">
                                    <option value="">{{ 'Select a tax rule'|trans }}</option>
                                    {% for option in delivery_tax_rules %}
                                        <option value="{{ option.id }}" {{ delivery_tax_rule_selected == option.id ? 'selected' : '' }}>{{ option.title }}</option>
                                    {% endfor %}
                                </select>
                                <button type="submit" class="btn btn-primary" data-testid="tax-rule-delivery-save">
                                    <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                                </button>
                            </div>
                            <div class="form-text">{{ 'Applied to the postage of every delivery module that has no rule of its own.'|trans }}</div>
                        </form>
                    </div>
                </div>

                <div class="card" data-testid="postage-tax-rule-card">
                    <div class="card-body">
                        <h3 class="h6">{{ 'Postage tax rule per delivery module'|trans }}</h3>

                        {% if delivery_module_rows is empty %}
                            <p class="text-muted mb-0">{{ 'No delivery module is activated.'|trans }}</p>
                        {% else %}
                            <form method="post" action="{{ path('admin.configuration.taxes-rules.delivery.modules.postage.update') }}?_token={{ assignToken() }}" data-testid="postage-tax-rule-form">
                                <div class="table-responsive">
                                    <table class="table align-middle mb-3">
                                        <thead>
                                            <tr>
                                                <th scope="col">{{ 'Delivery module'|trans }}</th>
                                                <th scope="col">{{ 'Tax rule'|trans }}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for row in delivery_module_rows %}
                                                <tr data-testid="postage-tax-rule-row-{{ row.code }}">
                                                    <td>
                                                        {{ row.title }}
                                                        {% if row.has_own_setting %}
                                                            <div class="form-text">
                                                                <i class="bi bi-info-circle" aria-hidden="true"></i>
                                                                {{ 'This module carries its own postage tax rule, which takes precedence.'|trans }}
                                                                {% if row.configuration_url %}
                                                                    <a href="{{ row.configuration_url }}">{{ 'Configure'|trans }}</a>
                                                                {% endif %}
                                                            </div>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <label class="visually-hidden" for="postage-tax-rule-{{ row.id }}">{{ 'Tax rule'|trans }}</label>
                                                        <select id="postage-tax-rule-{{ row.id }}" name="postage-tax-rule[{{ row.id }}]" class="form-select">
                                                            <option value="">{{ 'Shop default'|trans }}</option>
                                                            {% for option in delivery_tax_rules %}
                                                                <option value="{{ option.id }}" {{ row.tax_rule_id == option.id ? 'selected' : '' }}>{{ option.title }}</option>
                                                            {% endfor %}
                                                        </select>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                                <button type="submit" class="btn btn-primary" data-testid="postage-tax-rule-save">
                                    <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </section>

            <section class="mt-4" data-testid="postage-tax-strategy-section">
                <h2 class="h5 mb-2">{{ 'Postage tax breakdown'|trans }}</h2>
                <div class="card">
                    <div class="card-body">
                        <form method="post" action="{{ path('admin.configuration.taxes-rules.postage.tax.strategy.update') }}?_token={{ assignToken() }}" data-testid="postage-tax-strategy-form">
                            <fieldset>
                                <legend class="form-label">{{ 'How the postage tax is split when a cart mixes several rates'|trans }}</legend>
                                {% for strategy in postage_tax_strategies %}
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" name="postage-tax-strategy" id="postage-tax-strategy-{{ strategy.value }}" value="{{ strategy.value }}" {{ postage_tax_strategy_selected == strategy.value ? 'checked' : '' }}>
                                        <label class="form-check-label" for="postage-tax-strategy-{{ strategy.value }}">
                                            {{ strategy.label }}
                                            <span class="form-text d-block">{{ strategy.description }}</span>
                                        </label>
                                    </div>
                                {% endfor %}
                            </fieldset>
                            <div class="alert alert-warning mt-3">
                                {{ 'The last two change the VAT the shop declares on mixed carts. They apply to the orders placed from now on; nothing is recomputed.'|trans }}
                            </div>
                            <button type="submit" class="btn btn-primary" data-testid="postage-tax-strategy-save">
                                <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                            </button>
                        </form>
                    </div>
                </div>
            </section>
        {% endif %}
    </div>

    {{ safe_hook('taxes-rules.bottom') }}
    {{ safe_hook('taxes-rules.js', { location: 'taxes-rules-js' }) }}

    {% include '@BackOfficeDefaultTwig/configuration/tax-rule/_tax_create_modal.html.twig' %}
    {% include '@BackOfficeDefaultTwig/configuration/tax-rule/_tax_delete_modal.html.twig' %}
    {% include '@BackOfficeDefaultTwig/configuration/tax-rule/_tax_rule_create_modal.html.twig' %}
    {% include '@BackOfficeDefaultTwig/configuration/tax-rule/_tax_rule_delete_modal.html.twig' %}
{% endblock %}
