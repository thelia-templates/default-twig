{% extends '@BackOfficeDefaultTwig/auth-layout.html.twig' %}

{% block title %}{{ 'Welcome'|trans }}{% endblock %}

{% block auth_title %}{{ 'Welcome back'|trans }}{% endblock %}

{% block auth_subtitle %}{{ 'Sign in to your back-office'|trans }}{% endblock %}

{% block flash %}
    {{ parent() }}
    {{ safe_hook('index.top') }}
{% endblock %}

{% block auth_content %}
    {% set login_form = getForm('thelia.admin.login') %}
    {% form_theme login_form with bo_form_themes only %}

    <form action="{{ path('admin.checklogin') }}" method="post" data-testid="login-form" novalidate>
        {{ form_widget(login_form._token) }}

        {% set target_path = app.request.query.get('_target_path')|default('') %}
        {% set redirect_url = target_path is not empty and target_path starts with '/admin' ? target_path : path('admin') %}
        <input type="hidden" name="{{ field_name(login_form.success_url) }}" value="{{ redirect_url }}">

        {% if login_form.vars.errors|length > 0 %}
            {# Render a single generic message so the form does not leak whether
               the username exists or the password is wrong (account enumeration). #}
            <div class="alert alert-danger" role="alert" data-testid="login-error">
                {{ 'Invalid credentials.'|trans }}
            </div>
        {% endif %}

        <div class="mb-3">
            {{ form_label(login_form.username, 'Username or e-mail address'|trans, {'label_attr': {'class': 'form-label'}}) }}
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                {{ form_widget(login_form.username, {
                    'attr': {
                        'class': 'form-control form-control-lg',
                        'placeholder': 'Username or e-mail address'|trans,
                        'autofocus': 'autofocus',
                        'data-testid': 'login-username',
                    },
                }) }}
            </div>
            {{ form_errors(login_form.username) }}
        </div>

        <div class="mb-3">
            {{ form_label(login_form.password, 'Password'|trans, {'label_attr': {'class': 'form-label'}}) }}
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                {{ form_widget(login_form.password, {
                    'attr': {
                        'class': 'form-control form-control-lg',
                        'placeholder': 'Password'|trans,
                        'data-testid': 'login-password',
                    },
                }) }}
            </div>
            {{ form_errors(login_form.password) }}
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="form-check">
                {{ form_widget(login_form.remember_me, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(login_form.remember_me, null, {'label_attr': {'class': 'form-check-label'}}) }}
            </div>

            {% if thelia_config('enable_lost_admin_password_recovery', false) %}
                <a class="text-decoration-none small" href="{{ path('admin.lost-password') }}" data-testid="login-forgot-password">
                    {{ 'Forgot your password?'|trans }}
                </a>
            {% endif %}
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100" data-testid="login-submit">
            <i class="bi bi-box-arrow-in-right me-2"></i>
            {{ 'Login'|trans }}
        </button>
    </form>

    <div class="text-center mt-4">
        <a class="text-decoration-none small" href="{{ path('index', {router: 'front'}) }}">
            <i class="bi bi-arrow-left me-1"></i>
            {{ 'Return to shop'|trans }}
        </a>
    </div>

    {{ safe_hook('index.middle') }}
{% endblock %}

{% block body %}
    {{ parent() }}
    {{ safe_hook('index.bottom') }}
{% endblock %}
