{# @var data {filters: list<array<string, mixed>>, filter_types: list<string>, enabled: bool, messages: list<string>} #}
{# Required ambient variables: scope_template_id or scope_category_id #}

<section id="choice-filter" class="mt-4" data-testid="choice-filter-section">
    <h2 class="h5 mb-3">
        {% if scope_template_id is defined and scope_template_id %}
            {{ 'Filter positions for this template'|trans }}
        {% else %}
            {{ 'Filter positions for this category'|trans }}
        {% endif %}
    </h2>

    {% for flash in bo_flashes('choice-filter-success') %}
        <div class="alert alert-success" role="alert" data-testid="choice-filter-flash">{{ flash }}</div>
    {% endfor %}

    {% for message in data.messages|default([]) %}
        <div class="alert alert-info" role="alert">{{ message }}</div>
    {% endfor %}

    {% if not data.enabled and scope_category_id is defined and scope_category_id %}
        <p class="text-body-secondary small">
            {{ 'Submitting the form below will create a category-specific filter configuration.'|trans }}
        </p>
    {% endif %}

    <form action="{{ path('admin.choicefilter.save') }}" method="post" data-testid="choice-filter-form">
        <input type="hidden" name="_token" value="{{ assignToken() }}">
        {% if scope_template_id is defined and scope_template_id %}
            <input type="hidden" name="ChoiceFilter[template_id]" value="{{ scope_template_id }}">
        {% endif %}
        {% if scope_category_id is defined and scope_category_id %}
            <input type="hidden" name="ChoiceFilter[category_id]" value="{{ scope_category_id }}">
        {% endif %}

        <div class="table-responsive">
            <table class="table table-sm align-middle{% if not data.enabled %} table-secondary{% endif %}">
                <thead class="table-light">
                    <tr>
                        <th>{{ 'ID'|trans }}</th>
                        <th>{{ 'Type'|trans }}</th>
                        <th>{{ 'Title'|trans }}</th>
                        <th>{{ 'Visible'|trans }}</th>
                        <th>{{ 'Position'|trans }}</th>
                        <th>{{ 'Display type'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for key, filter in data.filters|default([]) %}
                        <tr data-testid="choice-filter-row-{{ filter.Id }}">
                            <td>
                                <input type="hidden" name="ChoiceFilter[filter][{{ key }}][id]" value="{{ filter.Id }}">
                                {{ filter.Id }}
                            </td>
                            <td>
                                <input type="hidden" name="ChoiceFilter[filter][{{ key }}][type]" value="{{ filter.Type }}">
                                <span class="badge bg-secondary text-uppercase">{{ filter.Type }}</span>
                            </td>
                            <td>{{ filter.Title }}</td>
                            <td>
                                <select name="ChoiceFilter[filter][{{ key }}][visible]" class="form-select form-select-sm">
                                    <option value="1"{% if filter.Visible %} selected{% endif %}>{{ 'Yes'|trans }}</option>
                                    <option value="0"{% if not filter.Visible %} selected{% endif %}>{{ 'No'|trans }}</option>
                                </select>
                            </td>
                            <td>
                                <input type="number" step="1" min="0"
                                       name="ChoiceFilter[filter][{{ key }}][position]"
                                       value="{{ filter.Position }}"
                                       class="form-control form-control-sm" style="width: 6rem">
                            </td>
                            <td>
                                <select name="ChoiceFilter[filter][{{ key }}][display_type]" class="form-select form-select-sm">
                                    {% for type in data.filter_types|default([]) %}
                                        <option value="{{ type }}"{% if filter.DisplayType == type %} selected{% endif %}>{{ type }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-body-secondary py-3">
                                {{ 'No filter available.'|trans }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary" data-testid="choice-filter-submit">
                <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
            </button>
        </div>
    </form>

    {% if data.enabled and scope_category_id is defined and scope_category_id %}
        <form action="{{ path('admin.choicefilter.clear') }}" method="post" class="mt-3"
              data-testid="choice-filter-clear-form">
            <input type="hidden" name="_token" value="{{ assignToken() }}">
            <input type="hidden" name="ChoiceFilter[category_id]" value="{{ scope_category_id }}">
            <button type="submit" class="btn btn-outline-danger btn-sm" data-testid="choice-filter-reset">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                {{ 'Reset default values'|trans }}
            </button>
        </form>
    {% endif %}
</section>
