<!DOCTYPE html>
{# lang must be a valid BCP 47 tag: Thelia locales use underscores (en_US), browsers and Intl APIs require dashes (en-US) #}
<html lang="{{ app.request.locale|default('en')|replace({'_': '-'}) }}" data-bs-theme="light">
    {% block head %}
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <meta name="referrer" content="same-origin">

            <title>{% block title %}{{ 'Back-office'|trans }}{% endblock %} - Thelia</title>


            {% block javascripts %}
                {% block importmap %}{{ importmap('backOfficeApp') }}{% endblock %}
            {% endblock %}

            {% block head_extra %}{% endblock %}

            {% block head_hook %}
                {{ safe_hook('main.head-css') }}
            {% endblock %}
        </head>
    {% endblock %}

    <body class="bg-body-secondary" data-testid="{% block body_testid %}bo-page{% endblock %}" data-controller="bootstrap-bridge">
        {% block body %}
            <div class="bo-layout">
                {% block side_nav %}{% include '@BackOfficeDefaultTwig/_side_nav.html.twig' %}{% endblock %}

                <div class="bo-main flex-grow-1 d-flex flex-column">
                    {% block top_nav %}{% include '@BackOfficeDefaultTwig/_top_nav.html.twig' %}{% endblock %}

                    <main class="p-4 flex-grow-1" data-testid="bo-main">
                        {% block breadcrumb %}{% endblock %}
                        {% block flash %}
                            {% for type, messages in app.flashes %}
                                {% for message in messages %}
                                    <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert" data-testid="bo-flash-{{ type }}">
                                        {{ message }}
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                {% endfor %}
                            {% endfor %}
                        {% endblock %}

                        {{ safe_hook('main.before-content') }}
                        {% block content %}{% endblock %}
                        {{ safe_hook('main.after-content', { location: 'after_content' }) }}
                    </main>

                    {% block footer %}{% include '@BackOfficeDefaultTwig/_footer.html.twig' %}{% endblock %}
                </div>
            </div>
        {% endblock %}

        {# JS is loaded as ESM by importmap('app') in the document head. #}
        {% block scripts %}{% endblock %}

        {% block scripts_extra %}{% endblock %}
        {{ safe_hook('main.footer-js') }}
    </body>
</html>
