{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Modules'|trans }}{% endblock %}
{% block body_testid %}modules-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Modules'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('modules.top', { location: 'modules_top' }) }}

    <div class="container-fluid" data-testid="modules-page">
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Modules management'|trans } only %}
            {% block actions %}
                {% if is_granted('UPDATE', 'admin.module') %}
                    <form method="post" action="{{ path('admin.module.refresh') }}?_token={{ assignToken() }}" class="d-inline">
                        <button type="submit" class="btn btn-outline-secondary" data-testid="modules-refresh">
                            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> {{ 'Check modules'|trans }}
                        </button>
                    </form>
                {% endif %}
            {% endblock %}
        {% endembed %}

        {% for type, group in groups %}
            <section class="mb-4" data-testid="modules-block-{{ group.slug }}">
                <h2 class="h5 mb-2">{{ group.label }}</h2>
                {{ component('BoDataTable', {
                    id: 'modules-' ~ group.slug,
                    columns: [
                        column('id', 'ID'|trans),
                        column('code', 'Code'|trans),
                        column('title', 'Title'|trans),
                        column('version', 'Version'|trans),
                        column_toggle('activated', 'Active'|trans, 'toggle_url'),
                        column('position', 'Position'|trans, 'center'),
                        column_actions('_actions', 'Actions'|trans),
                    ],
                    rows: group.rows,
                    emptyMessage: 'No module of this type installed.'|trans,
                    tbodyAttributes: {
                        'data-controller': 'bo-sortable',
                        'data-bo-sortable-url-value': update_position_url,
                        'data-bo-sortable-token-value': update_position_token,
                        'data-bo-sortable-param-name-value': 'module_id',
                    },
                }) }}
            </section>
        {% endfor %}

        <div class="d-flex justify-content-end gap-2 mb-4">
            <a href="{{ path('admin.hook') }}" class="btn btn-outline-primary" data-testid="modules-manage-hooks">
                {{ 'Manage hooks'|trans }} <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a href="{{ path('admin.module-hook') }}" class="btn btn-outline-primary" data-testid="modules-manage-modules-hooks">
                {{ 'Manage modules attachements'|trans }} <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        </div>

        {% if allow_module_zip_install|default(false) %}
            <form action="{{ path('admin.module.install') }}" method="post" enctype="multipart/form-data" class="mt-4" data-testid="module-install-form">
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                <div class="row g-2 align-items-center">
                    <div class="col-md-8">
                        <label class="form-label">{{ 'Install a new module from a .zip file'|trans }}</label>
                        <input type="file" name="module" class="form-control" data-testid="module-install-file" accept=".zip" required>
                        <div class="form-text small">{{ 'The archive must contain a single root directory matching the module code.'|trans }}</div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100" data-testid="module-install-submit">
                            <i class="bi bi-cloud-upload" aria-hidden="true"></i> {{ 'Install'|trans }}
                        </button>
                    </div>
                </div>
            </form>
        {% endif %}
    </div>

    {{ safe_hook('modules.bottom', { location: 'modules_bottom' }) }}

    {% component 'BoConfirmDialog' with {
        id: 'module-delete-modal',
        title: 'Delete module',
        formAction: path('admin.module.delete'),
        testid: 'module-delete',
        prefillTrigger: 'data-module-id',
        prefillInput: 'module_id',
    } %}
        {% block body %}
            <p>{{ 'Do you really want to delete this module?'|trans }}</p>
            <input type="hidden" name="module_id" value="" data-bo-prefill-modal-target="input">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="1" name="delete-module-data" id="module-delete-data" data-testid="module-delete-data">
                <label class="form-check-label" for="module-delete-data">
                    {{ 'Also delete the data created by this module (tables, configuration variables…).'|trans }}
                </label>
            </div>
        {% endblock %}
    {% endcomponent %}

    {{ component('BoFetchDialog', {
        id: 'module-information-modal',
        title: 'Module information'|trans,
        testid: 'module-information',
    }) }}

    {{ component('BoFetchDialog', {
        id: 'module-documentation-modal',
        title: 'Module documentation'|trans,
        testid: 'module-documentation',
    }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('modules.js', { location: 'modules-js' }) }}
{% endblock %}
