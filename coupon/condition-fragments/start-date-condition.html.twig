{% set field_name = constant('Thelia\\Condition\\Implementation\\StartDate::START_DATE') %}
<input type="hidden" name="{{ field_name }}[operator]" value=">=">
<div class="mb-3">
    <label class="form-label" for="{{ field_name }}-value">{{ 'Validity start date'|trans }}</label>
    <input type="text" class="form-control" id="{{ field_name }}-value" name="{{ field_name }}[value]" value="{{ start_date_value|default('') }}" placeholder="{{ 'Format: %fmt'|trans({'%fmt': date_format}) }}">
    <small class="form-text text-muted">{{ 'Please enter the date using the %fmt format'|trans({'%fmt': date_format}) }}</small>
</div>
