{# Compact page header: title on the left, optional actions on the right.

    Usage:
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Orders'|trans } %}
            {% block actions %}
                <button class="btn btn-sm btn-primary">{{ 'Create'|trans }}</button>
            {% endblock %}
        {% endembed %}

    The actions slot collapses gracefully when not provided, leaving the
    title flush left with the same vertical rhythm as plain h1 headings. #}
<div class="bo-page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <h1 class="h4 mb-0 d-flex align-items-center gap-2">
        {% block title %}{{ title }}{% endblock %}
    </h1>
    <div class="d-flex flex-wrap align-items-center gap-2 bo-page-header__actions">
        {% block actions %}{% endblock %}
    </div>
</div>
