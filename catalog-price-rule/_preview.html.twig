{# The price before and after the rule under review, on a sample of what it covers.
   Rendered into the edit screen by the preview button; nothing here is stored. #}
<div data-testid="catalog-price-rule-preview">
    {% if error %}
        <div class="alert alert-danger mb-0" data-testid="catalog-price-rule-preview-error">{{ error }}</div>
    {% else %}
        {% if preview.unknownCriterionTypes is not empty %}
            <div class="alert alert-danger" data-testid="catalog-price-rule-preview-unknown">
                {{ 'A criterion of this rule (%types%) cannot be resolved by any installed module: the rule covers nothing until it is removed.'|trans({'%types%': preview.unknownCriterionTypes|join(', ')}) }}
            </div>
        {% endif %}
        <p class="mb-2" data-testid="catalog-price-rule-preview-count" data-product-count="{{ preview.affectedProductCount }}">
            {{ 'This rule covers %products% product(s), %sale_elements% sale element(s).'|trans({'%products%': preview.affectedProductCount, '%sale_elements%': preview.affectedSaleElementCount}) }}
        </p>
        {% if preview.lines is not empty %}
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-1">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'Reference'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'Before (tax incl.)'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'After (tax incl.)'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for line in preview.lines %}
                            <tr data-testid="catalog-price-rule-preview-line-{{ line.productSaleElementsId }}">
                                <td><code>{{ line.reference }}</code></td>
                                <td class="text-end">{{ line.taxedBefore|number_format(2, '.', ' ') }} {{ currency.symbol }}</td>
                                <td class="text-end {{ line.changedByTheRule ? 'fw-semibold text-success' : 'text-body-secondary' }}">{{ line.taxedAfter|number_format(2, '.', ' ') }} {{ currency.symbol }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <p class="form-text mb-0">{{ 'Prices in %currency%, tax included at the shop location, as the rules already running would leave them today. A greyed price is one this rule leaves unchanged.'|trans({'%currency%': currency.code}) }}</p>
        {% endif %}
    {% endif %}
</div>
