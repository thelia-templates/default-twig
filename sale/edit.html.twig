{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit sale'|trans }} - {{ sale.title }}{% endblock %}
{% block body_testid %}sale-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.sale.default') }}">{{ 'Sales'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ sale.title ?: '#' ~ sale.id }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('sale-edit.top', { sale_id: sale.id }) }}

    <div class="container-fluid"
         data-testid="sale-edit-page"
         data-controller="bo-sale-product-picker"
         data-bo-sale-product-picker-products-url-value="{{ products_url }}">

        {{ form_start(form, { action: path('admin.sale.save', { sale_id: sale.id }), attr: { 'data-testid': 'sale-edit-form' } }) }}
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h3 mb-0">{{ sale.title ?: '#' ~ sale.id }}</h1>
                <div class="d-flex gap-2">
                    <a href="{{ path('admin.sale.default') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to list'|trans }}
                    </a>
                    <button type="submit" class="btn btn-primary" data-testid="sale-edit-submit">
                        <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                    </button>
                </div>
            </div>

            <div class="mb-3">
                {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
            </div>

            {{ form_widget(form.id) }}
            {{ form_widget(form.locale) }}

            <div class="row">
                <div class="col-lg-8">
                    <div class="card mb-3">
                        <div class="card-header">{{ 'General information'|trans }}</div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    {{ form_label(form.title) }}
                                    {{ form_widget(form.title, { attr: { class: 'form-control' } }) }}
                                </div>
                                <div class="col-md-4 mb-3">
                                    {{ form_label(form.label) }}
                                    {{ form_widget(form.label, { attr: { class: 'form-control' } }) }}
                                </div>
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.chapo) }}
                                {{ form_widget(form.chapo, { attr: { class: 'form-control', rows: 2 } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.description) }}
                                {{ form_widget(form.description, { attr: { class: 'form-control', rows: 5 } }) }}
                            </div>
                            <div class="mb-0">
                                {{ form_label(form.postscriptum) }}
                                {{ form_widget(form.postscriptum, { attr: { class: 'form-control', rows: 2 } }) }}
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header">{{ 'Products covered by this sale'|trans }}</div>
                        <div class="card-body">
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-9">
                                    <label class="form-label" for="sale-categories">{{ 'Product categories'|trans }}</label>
                                    <select id="sale-categories" multiple size="6" class="form-select"
                                            data-bo-sale-product-picker-target="categories" data-testid="sale-categories">
                                        {% for category in all_categories %}
                                            <option value="{{ category.id }}" {% if category.id in selected_category_ids %}selected{% endif %}>{{ category.title }}</option>
                                        {% endfor %}
                                    </select>
                                    <div class="form-text">{{ 'Select categories then load their products.'|trans }}</div>
                                </div>
                                <div class="col-md-3">
                                    <button type="button" class="btn btn-outline-primary w-100"
                                            data-action="bo-sale-product-picker#loadProducts" data-testid="sale-load-products">
                                        <i class="bi bi-download" aria-hidden="true"></i> {{ 'Load products'|trans }}
                                    </button>
                                </div>
                            </div>

                            <div class="border rounded p-3" style="max-height: 320px; overflow-y: auto;"
                                 data-bo-sale-product-picker-target="productZone" data-testid="sale-product-zone">
                                {% for product in selected_products %}
                                    {% set product_av_ids = selected_product_attributes[product.id]|default([]) %}
                                    <div class="d-flex align-items-center gap-2 mb-1" data-product-id="{{ product.id }}">
                                        <div class="form-check flex-grow-1 mb-0">
                                            <input class="form-check-input" type="checkbox" name="products[]" value="{{ product.id }}" id="sale-product-{{ product.id }}" checked>
                                            <label class="form-check-label" for="sale-product-{{ product.id }}">
                                                <code>{{ product.ref }}</code> {{ product.title }}
                                            </label>
                                        </div>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#sale-product-attributes-modal"
                                                data-product-id="{{ product.id }}"
                                                data-product-label="{{ product.title }}"
                                                title="{{ 'Restrict to attribute values'|trans }}"
                                                data-testid="sale-product-attributes-{{ product.id }}">
                                            <i class="bi bi-sliders" aria-hidden="true"></i>
                                            <span class="badge bg-secondary{% if product_av_ids is empty %} d-none{% endif %} ms-1"
                                                  data-bo-sale-product-attributes-target="badge">{{ product_av_ids|length }}</span>
                                        </button>
                                    </div>
                                {% else %}
                                    <p class="text-body-secondary mb-0" data-bo-sale-product-picker-target="emptyHint">{{ 'No product selected yet. Pick categories and load their products.'|trans }}</p>
                                {% endfor %}
                            </div>

                            <div data-bo-sale-product-attributes-inputs>
                                {% for productId, avIds in selected_product_attributes %}
                                    {% if avIds is not empty %}
                                        <input type="hidden" name="product_attributes[{{ productId }}]" value="{{ avIds|join(',') }}">
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card mb-3">
                        <div class="card-header">{{ 'Settings'|trans }}</div>
                        <div class="card-body">
                            <div class="form-check form-switch mb-2">
                                {{ form_widget(form.active, { attr: { class: 'form-check-input' } }) }}
                                {{ form_label(form.active, null, { label_attr: { class: 'form-check-label' } }) }}
                            </div>
                            <div class="form-check form-switch mb-3">
                                {{ form_widget(form.display_initial_price, { attr: { class: 'form-check-input' } }) }}
                                {{ form_label(form.display_initial_price, null, { label_attr: { class: 'form-check-label' } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.start_date) }}
                                {{ form_widget(form.start_date, { attr: { class: 'form-control', placeholder: 'YYYY-MM-DD HH:mm:ss' } }) }}
                            </div>
                            <div class="mb-0">
                                {{ form_label(form.end_date) }}
                                {{ form_widget(form.end_date, { attr: { class: 'form-control', placeholder: 'YYYY-MM-DD HH:mm:ss' } }) }}
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header">{{ 'Discount'|trans }}</div>
                        <div class="card-body">
                            <div class="mb-3">
                                {{ form_label(form.price_offset_type) }}
                                {{ form_widget(form.price_offset_type, { attr: { class: 'form-select' } }) }}
                            </div>
                            <label class="form-label">{{ 'Discount value per currency'|trans }}</label>
                            {% for currency in currencies %}
                                <div class="input-group mb-2">
                                    <span class="input-group-text" style="min-width: 4.5rem;">{{ currency.code }}</span>
                                    <input type="number" step="0.01" min="0" class="form-control"
                                           name="price_offset[{{ currency.id }}]" value="{{ currency.offset }}"
                                           data-testid="sale-offset-{{ currency.id }}" aria-label="{{ currency.code }}">
                                    <span class="input-group-text">{{ currency.symbol }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
    </div>

    <div class="modal fade"
         id="sale-product-attributes-modal"
         tabindex="-1"
         aria-labelledby="sale-product-attributes-modal-title"
         aria-hidden="true"
         data-controller="bo-sale-product-attributes"
         data-bo-sale-product-attributes-url-template-value="{{ product_attributes_url_template }}">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="sale-product-attributes-modal-title">
                        {{ 'Attribute values'|trans }}: <span data-bo-sale-product-attributes-target="product"></span>
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                <div class="modal-body" data-bo-sale-product-attributes-target="body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                    <button type="button" class="btn btn-primary" data-action="bo-sale-product-attributes#save" data-testid="sale-product-attributes-save">
                        <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save selection'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    {{ safe_hook('sale-edit.bottom', { sale_id: sale.id }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('sale.edit-js', { sale_id: sale.id, location: 'sale-edit-js' }) }}
{% endblock %}
