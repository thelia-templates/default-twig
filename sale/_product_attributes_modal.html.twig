{% if groups is empty %}
    <div class="alert alert-info mb-0">
        {{ 'This product has no combinations. The sale will apply to the whole product.'|trans }}
    </div>
{% else %}
    <p class="text-body-secondary small mb-3">
        {{ 'Select the attribute values to restrict the sale to. Leave empty to apply to all combinations.'|trans }}
    </p>
    <div data-bo-sale-product-attributes-target="form">
        {% for group in groups %}
            <fieldset class="border rounded p-3 mb-3">
                <legend class="float-none w-auto px-2 fs-6 text-body-secondary">{{ group.attribute.title }}</legend>
                {% for av in group.avs %}
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="sale-attr-av-{{ av.id }}"
                               value="{{ av.id }}"
                               data-bo-sale-product-attributes-target="checkbox"
                               {% if av.id in selected %}checked{% endif %}>
                        <label class="form-check-label" for="sale-attr-av-{{ av.id }}">{{ av.title }}</label>
                    </div>
                {% endfor %}
            </fieldset>
        {% endfor %}
    </div>
{% endif %}
