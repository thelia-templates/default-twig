{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Sales'|trans }}{% endblock %}
{% block body_testid %}sales-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.tools.index') }}">{{ 'Tools'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Sales'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('sales.top', { location: 'sales_top' }) }}

    <div class="container-fluid" data-testid="sales-page">
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Sales & promotions'|trans } %}
            {% block actions %}
                <a href="{{ global_actions.check_url }}" class="btn btn-outline-secondary btn-sm" data-testid="sales-check-activation"
                   title="{{ 'Refresh the active status of every sale according to its dates.'|trans }}">
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> {{ 'Check activation'|trans }}
                </a>
                <a href="{{ global_actions.reset_url }}" class="btn btn-outline-secondary btn-sm" data-testid="sales-reset-status"
                   title="{{ 'Remove the sale flag from every product before recomputing it.'|trans }}">
                    <i class="bi bi-eraser" aria-hidden="true"></i> {{ 'Reset status'|trans }}
                </a>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#sale-create-modal" data-testid="sale-create-btn">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i> {{ 'New sale'|trans }}
                </button>
            {% endblock %}
        {% endembed %}

        <div class="card">
            <div class="table-responsive">
                <table class="table align-middle mb-0" data-testid="sales-table">
                    <thead class="table-light">
                        <tr>
                            <th>{% include '@BackOfficeDefaultTwig/_sort_header.html.twig' with { label: 'Title'|trans, field: 'title', current: sort_field, direction: sort_direction } only %}</th>
                            <th>{% include '@BackOfficeDefaultTwig/_sort_header.html.twig' with { label: 'Label'|trans, field: 'label', current: sort_field, direction: sort_direction } only %}</th>
                            <th>{% include '@BackOfficeDefaultTwig/_sort_header.html.twig' with { label: 'Start date'|trans, field: 'start_date', current: sort_field, direction: sort_direction } only %}</th>
                            <th>{% include '@BackOfficeDefaultTwig/_sort_header.html.twig' with { label: 'End date'|trans, field: 'end_date', current: sort_field, direction: sort_direction } only %}</th>
                            <th>{{ 'Discount type'|trans }}</th>
                            <th class="text-center">{{ 'Products'|trans }}</th>
                            <th class="text-center">{% include '@BackOfficeDefaultTwig/_sort_header.html.twig' with { label: 'Status'|trans, field: 'active', current: sort_field, direction: sort_direction } only %}</th>
                            <th class="text-end">{{ 'Actions'|trans }}</th>
                            {{ safe_hook('sales.table-header', { location: 'sales_table_header' }) }}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr data-testid="sale-row-{{ row.id }}">
                                <td><a href="{{ row.edit_url }}" class="fw-semibold text-decoration-none">{{ row.title ?: '#' ~ row.id }}</a></td>
                                <td>{% if row.label %}<span class="badge bg-danger-subtle text-danger-emphasis">{{ row.label }}</span>{% else %}<span class="text-body-secondary">-</span>{% endif %}</td>
                                <td>{{ row.start_date ?? '-' }}</td>
                                <td>{{ row.end_date ?? '-' }}</td>
                                <td>{{ row.offset_type_label }}</td>
                                <td class="text-center">{{ row.products_count }}</td>
                                <td class="text-center">
                                    <a href="{{ row.toggle_url }}" class="text-decoration-none" data-testid="sale-toggle-{{ row.id }}">
                                        {% if row.active %}
                                            <span class="badge bg-success">{{ 'Active'|trans }}</span>
                                        {% else %}
                                            <span class="badge bg-secondary">{{ 'Inactive'|trans }}</span>
                                        {% endif %}
                                    </a>
                                </td>
                                <td class="text-end">
                                    <a href="{{ row.edit_url }}" class="btn btn-sm btn-outline-secondary" data-testid="sale-edit-{{ row.id }}" title="{{ 'Edit'|trans }}">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#sale-delete-modal"
                                            data-sale-id="{{ row.id }}"
                                            data-testid="sale-delete-{{ row.id }}" title="{{ 'Delete'|trans }}">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </td>
                                {{ safe_hook('sales.table-row', { sale_id: row.id, location: 'sales_table_row' }) }}
                            </tr>
                        {% else %}
                            <tr><td colspan="8" class="text-body-secondary text-center py-4">{{ 'No sale yet. Create your first promotion.'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal fade" id="sale-create-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            {{ form_start(create_form, { action: path('admin.sale.create'), attr: { 'data-testid': 'sale-create-form' } }) }}
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5">{{ 'New sale'|trans }}</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        {{ form_widget(create_form.locale) }}
                        <div class="mb-3">
                            {{ form_label(create_form.title) }}
                            {{ form_widget(create_form.title, { attr: { class: 'form-control' } }) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(create_form.label) }}
                            {{ form_widget(create_form.label, { attr: { class: 'form-control' } }) }}
                            <div class="form-text">{{ 'The short label shown on discounted products (e.g. "Sale", "-20%").'|trans }}</div>
                        </div>
                        {{ safe_hook('sale.create-form', { location: 'sale_create_form' }) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="submit" class="btn btn-primary" data-testid="sale-create-submit">{{ 'Create and configure'|trans }}</button>
                    </div>
                </div>
            {{ form_end(create_form) }}
        </div>
    </div>

    {{ component('BoConfirmDialog', {
        id: 'sale-delete-modal',
        title: 'Delete sale',
        formAction: global_actions.delete_url ~ '?_token=' ~ global_actions.delete_token,
        token: false,
        message: 'Do you really want to delete this sale?',
        testid: 'sale-delete',
        hook: 'sale.delete-form',
        hookContext: { location: 'sale_delete_form' },
        prefillTrigger: 'data-sale-id',
        prefillInput: 'sale_id',
    }) }}

    {{ safe_hook('sales.bottom', { location: 'sales_bottom' }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('sales.js', { location: 'sales-js' }) }}
{% endblock %}
